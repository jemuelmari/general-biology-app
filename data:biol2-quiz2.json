  "type": "quiz",
  "title": "Quiz 2 — DNA, Protein Synthesis & Evolution Foundations",
  "timeLimit": 1200,
  "passingScore": 80,
  "items": [
    { "id": "q2-01", "competency": "STEM_BIO11/12-IIIa-b-4", "text": "Which sugar is found in DNA?", "options": [{"key":"a","label":"Ribose","correct":false},{"key":"b","label":"Deoxyribose","correct":true},{"key":"c","label":"Glucose","correct":false},{"key":"d","label":"Fructose","correct":false}] },
    { "id": "q2-02", "competency": "STEM_BIO11/12-IIIa-b-4", "text": "In DNA, adenine pairs with:", "options": [{"key":"a","label":"Guanine","correct":false},{"key":"b","label":"Cytosine","correct":false},{"key":"c","label":"Thymine","correct":true},{"key":"d","label":"Uracil","correct":false}] },
    { "id": "q2-03", "competency": "STEM_BIO11/12-IIIa-b-4", "text": "The three components of a nucleotide are:", "options": [{"key":"a","label":"Sugar, phosphate, nitrogenous base","correct":true},{"key":"b","label":"Glycerol, fatty acid, phosphate","correct":false},{"key":"c","label":"Amino, carboxyl, R group","correct":false},{"key":"d","label":"Carbon, hydrogen, oxygen","correct":false}] },
    { "id": "q2-04", "competency": "STEM_BIO11/12-IIIa-b-5", "text": "During DNA replication, the two strands are separated by:", "options": [{"key":"a","label":"DNA polymerase","correct":false},{"key":"b","label":"Helicase","correct":true},{"key":"c","label":"Ligase","correct":false},{"key":"d","label":"Primase","correct":false}] },
    { "id": "q2-05", "competency": "STEM_BIO11/12-IIIa-b-5", "text": "The process by which DNA makes mRNA is called:", "options": [{"key":"a","label":"Translation","correct":false},{"key":"b","label":"Transcription","correct":true},{"key":"c","label":"Replication","correct":false},{"key":"d","label":"Mutation","correct":false}] },
    { "id": "q2-06", "competency": "STEM_BIO11/12-IIIa-b-5", "text": "Translation occurs at the:", "options": [{"key":"a","label":"Nucleus","correct":false},{"key":"b","label":"Ribosome","correct":true},{"key":"c","label":"Mitochondria","correct":false},{"key":"d","label":"Golgi","correct":false}] },
    { "id": "q2-07", "competency": "STEM_BIO11/12-IIIa-b-5", "text": "A codon consists of how many nucleotides?", "options": [{"key":"a","label":"1","correct":false},{"key":"b","label":"2","correct":false},{"key":"c","label":"3","correct":true},{"key":"d","label":"4","correct":false}] },
    { "id": "q2-08", "competency": "STEM_BIO11/12-IIIa-b-6", "text": "Which enzyme cuts DNA at specific sequences for genetic engineering?", "options": [{"key":"a","label":"DNA ligase","correct":false},{"key":"b","label":"Restriction enzyme","correct":true},{"key":"c","label":"Helicase","correct":false},{"key":"d","label":"Polymerase","correct":false}] },
    { "id": "q2-09", "competency": "STEM_BIO11/12-IIIa-b-6", "text": "A plasmid is:", "options": [{"key":"a","label":"A viral protein","correct":false},{"key":"b","label":"A circular DNA vector","correct":true},{"key":"c","label":"An enzyme","correct":false},{"key":"d","label":"A chromosome","correct":false}] },
    { "id": "q2-10", "competency": "STEM_BIO11/12-IIIa-b-7", "text": "Which of the following is a real application of recombinant DNA?", "options": [{"key":"a","label":"Insulin production","correct":true},{"key":"b","label":"Water purification","correct":false},{"key":"c","label":"Metal smelting","correct":false},{"key":"d","label":"Solar panels","correct":false}] },
    { "id": "q2-11", "competency": "STEM_BIO11/12-IIIC-g-8", "text": "Which era is known as the 'Age of Reptiles'?", "options": [{"key":"a","label":"Paleozoic","correct":false},{"key":"b","label":"Mesozoic","correct":true},{"key":"c","label":"Cenozoic","correct":false},{"key":"d","label":"Precambrian","correct":false}] },
    { "id": "q2-12", "competency": "STEM_BIO11/12-IIIC-g-9", "text": "Which mechanism of evolution is random?", "options": [{"key":"a","label":"Natural selection","correct":false},{"key":"b","label":"Genetic drift","correct":true},{"key":"c","label":"Artificial selection","correct":false},{"key":"d","label":"Directional selection","correct":false}] },
    { "id": "q2-13", "competency": "STEM_BIO11/12-IIIC-g-9", "text": "Natural selection acts on:", "options": [{"key":"a","label":"Genotypes directly","correct":false},{"key":"b","label":"Phenotypes","correct":true},{"key":"c","label":"Chromosomes","correct":false},{"key":"d","label":"Gametes only","correct":false}] },
    { "id": "q2-14", "competency": "STEM_BIO11/12-IIIC-g-10", "text": "Descent with modification means:", "options": [{"key":"a","label":"Species are fixed","correct":false},{"key":"b","label":"Species change over time and share common ancestors","correct":true},{"key":"c","label":"All life is unrelated","correct":false},{"key":"d","label":"Evolution is random","correct":false}] },
    { "id": "q2-15", "competency": "STEM_BIO11/12-IIIC-g-11", "text": "Who proposed the theory of natural selection?", "options": [{"key":"a","label":"Lamarck","correct":false},{"key":"b","label":"Darwin","correct":true},{"key":"c","label":"Linnaeus","correct":false},{"key":"d","label":"Mendel","correct":false}] },
    { "id": "q2-16", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "Homologous structures provide evidence for:", "options": [{"key":"a","label":"Convergent evolution","correct":false},{"key":"b","label":"Common ancestry","correct":true},{"key":"c","label":"Spontaneous generation","correct":false},{"key":"d","label":"Genetic drift","correct":false}] },
    { "id": "q2-17", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "The fossil record provides evidence for:", "options": [{"key":"a","label":"Evolutionary change over time","correct":true},{"key":"b","label":"Creationism","correct":false},{"key":"c","label":"Spontaneous generation","correct":false},{"key":"d","label":"Intelligent design","correct":false}] },
    { "id": "q2-18", "competency": "STEM_BIO11/12-IIIC-g-13", "text": "Comparative embryology shows:", "options": [{"key":"a","label":"Embryos of different species share common features","correct":true},{"key":"b","label":"Embryos are unrelated","correct":false},{"key":"c","label":"Only mammals have embryos","correct":false},{"key":"d","label":"Embryos don't change","correct":false}] },
    { "id": "q2-19", "competency": "STEM_BIO11/12-IIIH-j-14", "text": "Which taxonomic rank is the broadest?", "options": [{"key":"a","label":"Domain","correct":true},{"key":"b","label":"Kingdom","correct":false},{"key":"c","label":"Phylum","correct":false},{"key":"d","label":"Genus","correct":false}] },
    { "id": "q2-20", "competency": "STEM_BIO11/12-IIIH-j-15", "text": "A taxon is:", "options": [{"key":"a","label":"A group of organisms at any level of classification","correct":true},{"key":"b","label":"A species only","correct":false},{"key":"c","label":"A gene","correct":false},{"key":"d","label":"A fossil","correct":false}] }
  ]
}