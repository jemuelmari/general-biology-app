  "title": "Summative Test 2 — Biological Molecules, Enzymes, Photosynthesis & Respiration (Weeks 5–8)",
  "timeLimit": 1800,
  "passingScore": 80,
  "items": [
    { "id": "st2-01", "competency": "STEM_BIO11/12-II-i-j-15", "text": "Which polysaccharide is used for energy storage in animals?", "options": [{"key":"a","label":"Cellulose","correct":false},{"key":"b","label":"Glycogen","correct":true},{"key":"c","label":"Starch","correct":false},{"key":"d","label":"Chitin","correct":false}] },
    { "id": "st2-02", "competency": "STEM_BIO11/12-II-i-j-15", "text": "A disaccharide is formed by:", "options": [{"key":"a","label":"Two monosaccharides","correct":true},{"key":"b","label":"Many monosaccharides","correct":false},{"key":"c","label":"One monosaccharide","correct":false},{"key":"d","label":"Glycerol + fatty acids","correct":false}] },
    { "id": "st2-03", "competency": "STEM_BIO11/12-II-i-j-15", "text": "Which is a saturated fat?", "options": [{"key":"a","label":"Olive oil","correct":false},{"key":"b","label":"Butter","correct":true},{"key":"c","label":"Fish oil","correct":false},{"key":"d","label":"Canola oil","correct":false}] },
    { "id": "st2-04", "competency": "STEM_BIO11/12-II-i-j-15", "text": "Which level of protein structure involves multiple polypeptide chains?", "options": [{"key":"a","label":"Primary","correct":false},{"key":"b","label":"Secondary","correct":false},{"key":"c","label":"Tertiary","correct":false},{"key":"d","label":"Quaternary","correct":true}] },
    { "id": "st2-05", "competency": "STEM_BIO11/12-II-i-j-15", "text": "Which is a function of proteins?", "options": [{"key":"a","label":"Genetic storage","correct":false},{"key":"b","label":"Enzyme catalysis","correct":true},{"key":"c","label":"Quick energy","correct":false},{"key":"d","label":"Insulation","correct":false}] },
    { "id": "st2-06", "competency": "STEM_BIO11/12-II-i-j-15", "text": "DNA differs from RNA in that DNA:", "options": [{"key":"a","label":"Contains uracil","correct":false},{"key":"b","label":"Is double-stranded","correct":true},{"key":"c","label":"Contains ribose","correct":false},{"key":"d","label":"Is single-stranded","correct":false}] },
    { "id": "st2-07", "competency": "STEM_BIO11/12-II-i-j-16", "text": "Which biomolecule primarily powers rapid bursts of cellular work?", "options": [{"key":"a","label":"Carbohydrates","correct":true},{"key":"b","label":"Lipids","correct":false},{"key":"c","label":"Proteins","correct":false},{"key":"d","label":"Nucleic acids","correct":false}] },
    { "id": "st2-08", "competency": "STEM_BIO11/12-II-i-j-16", "text": "Which biomolecule serves as a long-term energy reservoir?", "options": [{"key":"a","label":"Carbohydrates","correct":false},{"key":"b","label":"Lipids","correct":true},{"key":"c","label":"Proteins","correct":false},{"key":"d","label":"Nucleic acids","correct":false}] },
    { "id": "st2-09", "competency": "STEM_BIO11/12-II-i-j-17", "text": "A coenzyme is:", "options": [{"key":"a","label":"A metal ion","correct":false},{"key":"b","label":"An organic helper molecule","correct":true},{"key":"c","label":"A protein portion","correct":false},{"key":"d","label":"A substrate","correct":false}] },
    { "id": "st2-10", "competency": "STEM_BIO11/12-II-i-j-17", "text": "Which factor, when too high, denatures most enzymes?", "options": [{"key":"a","label":"pH","correct":false},{"key":"b","label":"Substrate concentration","correct":false},{"key":"c","label":"Temperature","correct":true},{"key":"d","label":"Enzyme concentration","correct":false}] },
    { "id": "st2-11", "competency": "STEM_BIO11/12-II-i-j-17", "text": "A competitive inhibitor:", "options": [{"key":"a","label":"Binds the active site","correct":true},{"key":"b","label":"Binds elsewhere","correct":false},{"key":"c","label":"Denatures the enzyme","correct":false},{"key":"d","label":"Adds a cofactor","correct":false}] },
    { "id": "st2-12", "competency": "STEM_BIO11/12-II-i-j-18", "text": "Reduction is:", "options": [{"key":"a","label":"Loss of electrons","correct":false},{"key":"b","label":"Gain of electrons","correct":true},{"key":"c","label":"Loss of protons","correct":false},{"key":"d","label":"Gain of neutrons","correct":false}] },
    { "id": "st2-13", "competency": "STEM_BIO11/12-II-i-j-18", "text": "Which electron carrier is used in photosynthesis?", "options": [{"key":"a","label":"NAD⁺","correct":false},{"key":"b","label":"FAD","correct":false},{"key":"c","label":"NADP⁺","correct":true},{"key":"d","label":"ATP","correct":false}] },
    { "id": "st2-14", "competency": "STEM_BIO11/12-II-i-j-18", "text": "In respiration, glucose is:", "options": [{"key":"a","label":"Reduced","correct":false},{"key":"b","label":"Oxidized","correct":true},{"key":"c","label":"Denatured","correct":false},{"key":"d","label":"Neutralized","correct":false}] },
    { "id": "st2-15", "competency": "STEM_BIO11/12-IIa-j-1", "text": "ATP hydrolysis produces:", "options": [{"key":"a","label":"ADP + Pi + Energy","correct":true},{"key":"b","label":"AMP + 2 Pi","correct":false},{"key":"c","label":"Adenine only","correct":false},{"key":"d","label":"NADH","correct":false}] },
    { "id": "st2-16", "competency": "STEM_BIO11/12-IIa-j-2", "text": "The overall equation for photosynthesis is:", "options": [{"key":"a","label":"6CO₂ + 6H₂O + light → C₆H₁₂O₆ + 6O₂","correct":true},{"key":"b","label":"C₆H₁₂O₆ + 6O₂ → 6CO₂ + 6H₂O","correct":false},{"key":"c","label":"6O₂ + 6H₂O → C₆H₁₂O₆","correct":false},{"key":"d","label":"CO₂ + H₂O → ATP","correct":false}] },
    { "id": "st2-17", "competency": "STEM_BIO11/12-IIa-j-3", "text": "Why do leaves appear green?", "options": [{"key":"a","label":"Chlorophyll absorbs green light","correct":false},{"key":"b","label":"Chlorophyll reflects green light","correct":true},{"key":"c","label":"Carotenoids reflect green","correct":false},{"key":"d","label":"Glucose is green","correct":false}] },
    { "id": "st2-18", "competency": "STEM_BIO11/12-IIa-j-4", "text": "Electrons flow from PSII to PSI through:", "options": [{"key":"a","label":"ATP synthase","correct":false},{"key":"b","label":"The electron transport chain","correct":true},{"key":"c","label":"The Calvin cycle","correct":false},{"key":"d","label":"RuBisCO","correct":false}] },
    { "id": "st2-19", "competency": "STEM_BIO11/12-IIa-j-4", "text": "O₂ released during photosynthesis comes from:", "options": [{"key":"a","label":"CO₂","correct":false},{"key":"b","label":"Glucose","correct":false},{"key":"c","label":"Water","correct":true},{"key":"d","label":"ATP","correct":false}] },
    { "id": "st2-20", "competency": "STEM_BIO11/12-IIa-j-5", "text": "Which phase of the Calvin cycle uses ATP and NADPH?", "options": [{"key":"a","label":"Carbon fixation","correct":false},{"key":"b","label":"Reduction","correct":true},{"key":"c","label":"Regeneration","correct":false},{"key":"d","label":"Photolysis","correct":false}] },
    { "id": "st2-21", "competency": "STEM_BIO11/12-IIa-j-5", "text": "The enzyme RuBisCO fixes:", "options": [{"key":"a","label":"O₂","correct":false},{"key":"b","label":"CO₂","correct":true},{"key":"c","label":"N₂","correct":false},{"key":"d","label":"H₂O","correct":false}] },
    { "id": "st2-22", "competency": "STEM_BIO11/12-IIa-j-6", "text": "Which requires oxygen?", "options": [{"key":"a","label":"Fermentation","correct":false},{"key":"b","label":"Aerobic respiration","correct":true},{"key":"c","label":"Glycolysis","correct":false},{"key":"d","label":"Lactic acid production","correct":false}] },
    { "id": "st2-23", "competency": "STEM_BIO11/12-IIa-j-6", "text": "Which organism produces ethanol during fermentation?", "options": [{"key":"a","label":"Yeast","correct":true},{"key":"b","label":"Muscle cells","correct":false},{"key":"c","label":"Nerve cells","correct":false},{"key":"d","label":"Red blood cells","correct":false}] },
    { "id": "st2-24", "competency": "STEM_BIO11/12-IIa-j-7", "text": "Where does glycolysis occur?", "options": [{"key":"a","label":"Cytoplasm","correct":true},{"key":"b","label":"Mitochondria","correct":false},{"key":"c","label":"Nucleus","correct":false},{"key":"d","label":"Chloroplast","correct":false}] },
    { "id": "st2-25", "competency": "STEM_BIO11/12-IIa-j-7", "text": "Products of glycolysis per glucose:", "options": [{"key":"a","label":"2 pyruvate, 2 ATP, 2 NADH","correct":true},{"key":"b","label":"1 pyruvate, 4 ATP","correct":false},{"key":"c","label":"6 CO₂, 2 ATP","correct":false},{"key":"d","label":"2 glucose, 4 ATP","correct":false}] },
    { "id": "st2-26", "competency": "STEM_BIO11/12-IIa-j-8", "text": "Where does the Krebs cycle occur?", "options": [{"key":"a","label":"Cytoplasm","correct":false},{"key":"b","label":"Mitochondrial matrix","correct":true},{"key":"c","label":"Thylakoid","correct":false},{"key":"d","label":"Nucleus","correct":false}] },
    { "id": "st2-27", "competency": "STEM_BIO11/12-IIa-j-8", "text": "Which produces the most ATP per glucose?", "options": [{"key":"a","label":"Glycolysis","correct":false},{"key":"b","label":"Krebs cycle","correct":false},{"key":"c","label":"Electron transport chain","correct":true},{"key":"d","label":"Fermentation","correct":false}] },
    { "id": "st2-28", "competency": "STEM_BIO11/12-IIa-j-9", "text": "How many ATP does each NADH yield (modern estimate)?", "options": [{"key":"a","label":"1.5","correct":false},{"key":"b","label":"2.5","correct":true},{"key":"c","label":"3","correct":false},{"key":"d","label":"4","correct":false}] },
    { "id": "st2-29", "competency": "STEM_BIO11/12-IIa-j-10", "text": "What is the final electron acceptor in aerobic respiration?", "options": [{"key":"a","label":"NAD⁺","correct":false},{"key":"b","label":"O₂","correct":true},{"key":"c","label":"FAD","correct":false},{"key":"d","label":"ATP","correct":false}] },
    { "id": "st2-30", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which is a disadvantage of fermentation?", "options": [{"key":"a","label":"Requires oxygen","correct":false},{"key":"b","label":"Low ATP yield","correct":true},{"key":"c","label":"Very slow","correct":false},{"key":"d","label":"Produces O₂","correct":false}] }
  ]
}