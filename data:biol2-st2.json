{
  "assessmentId": "biol2-st2",
  "subject": "biol2",
  "type": "st",
  "title": "Summative Test 2 — DNA, Protein Synthesis, Evolution & Systematics (Weeks 5–8)",
  "timeLimit": 1800,
  "passingScore": 80,
  "items": [
    { "id": "st2-01", "competency": "STEM_BIO11/12-IIIa-b-4", "text": "The two strands of DNA are held together by:", "options": [{"key":"a","label":"Peptide bonds","correct":false},{"key":"b","label":"Hydrogen bonds","correct":true},{"key":"c","label":"Ionic bonds","correct":false},{"key":"d","label":"Covalent bonds only","correct":false}] },
    { "id": "st2-02", "competency": "STEM_BIO11/12-IIIa-b-4", "text": "In RNA, adenine pairs with:", "options": [{"key":"a","label":"Thymine","correct":false},{"key":"b","label":"Uracil","correct":true},{"key":"c","label":"Guanine","correct":false},{"key":"d","label":"Cytosine","correct":false}] },
    { "id": "st2-03", "competency": "STEM_BIO11/12-IIIa-b-4", "text": "Which nitrogenous bases are purines?", "options": [{"key":"a","label":"Adenine and Guanine","correct":true},{"key":"b","label":"Cytosine and Thymine","correct":false},{"key":"c","label":"Adenine and Thymine","correct":false},{"key":"d","label":"Uracil and Cytosine","correct":false}] },
    { "id": "st2-04", "competency": "STEM_BIO11/12-IIIa-b-5", "text": "DNA replication is described as semi-conservative because:", "options": [{"key":"a","label":"Each new DNA has one old strand and one new strand","correct":true},{"key":"b","label":"Both strands are new","correct":false},{"key":"c","label":"Both strands are old","correct":false},{"key":"d","label":"Only RNA is made","correct":false}] },
    { "id": "st2-05", "competency": "STEM_BIO11/12-IIIa-b-5", "text": "Which enzyme adds nucleotides to a growing DNA strand?", "options": [{"key":"a","label":"Helicase","correct":false},{"key":"b","label":"DNA polymerase","correct":true},{"key":"c","label":"Ligase","correct":false},{"key":"d","label":"Primase","correct":false}] },
    { "id": "st2-06", "competency": "STEM_BIO11/12-IIIa-b-5", "text": "The process of making protein from mRNA is called:", "options": [{"key":"a","label":"Replication","correct":false},{"key":"b","label":"Transcription","correct":false},{"key":"c","label":"Translation","correct":true},{"key":"d","label":"Mutation","correct":false}] },
    { "id": "st2-07", "competency": "STEM_BIO11/12-IIIa-b-5", "text": "The start codon is:", "options": [{"key":"a","label":"AUG","correct":true},{"key":"b","label":"UAA","correct":false},{"key":"c","label":"UAG","correct":false},{"key":"d","label":"UGA","correct":false}] },
    { "id": "st2-08", "competency": "STEM_BIO11/12-IIIa-b-5", "text": "Which molecule brings amino acids to the ribosome?", "options": [{"key":"a","label":"mRNA","correct":false},{"key":"b","label":"tRNA","correct":true},{"key":"c","label":"rRNA","correct":false},{"key":"d","label":"DNA","correct":false}] },
    { "id": "st2-09", "competency": "STEM_BIO11/12-IIIa-b-5", "text": "The three stop codons are:", "options": [{"key":"a","label":"UAA, UAG, UGA","correct":true},{"key":"b","label":"AUG, UAA, UAG","correct":false},{"key":"c","label":"AAA, GGG, CCC","correct":false},{"key":"d","label":"UUA, UUC, UUG","correct":false}] },
    { "id": "st2-10", "competency": "STEM_BIO11/12-IIIa-b-6", "text": "Restriction enzymes recognize:", "options": [{"key":"a","label":"Random sequences","correct":false},{"key":"b","label":"Specific DNA sequences","correct":true},{"key":"c","label":"Proteins","correct":false},{"key":"d","label":"RNA only","correct":false}] },
    { "id": "st2-11", "competency": "STEM_BIO11/12-IIIa-b-6", "text": "Which enzyme seals DNA fragments together?", "options": [{"key":"a","label":"Ligase","correct":true},{"key":"b","label":"Polymerase","correct":false},{"key":"c","label":"Helicase","correct":false},{"key":"d","label":"Protease","correct":false}] },
    { "id": "st2-12", "competency": "STEM_BIO11/12-IIIa-b-7", "text": "Recombinant insulin is produced using:", "options": [{"key":"a","label":"Bacteria with human insulin gene","correct":true},{"key":"b","label":"Cow pancreas only","correct":false},{"key":"c","label":"Fungi","correct":false},{"key":"d","label":"Plant extracts","correct":false}] },
    { "id": "st2-13", "competency": "STEM_BIO11/12-IIIa-b-7", "text": "Genetically modified crops (GMOs) are used for:", "options": [{"key":"a","label":"Pest resistance and higher yield","correct":true},{"key":"b","label":"Reducing plant growth","correct":false},{"key":"c","label":"Stopping photosynthesis","correct":false},{"key":"d","label":"Making plants predators","correct":false}] },
    { "id": "st2-14", "competency": "STEM_BIO11/12-IIIC-g-8", "text": "The oldest geologic era is:", "options": [{"key":"a","label":"Precambrian","correct":true},{"key":"b","label":"Paleozoic","correct":false},{"key":"c","label":"Mesozoic","correct":false},{"key":"d","label":"Cenozoic","correct":false}] },
    { "id": "st2-15", "competency": "STEM_BIO11/12-IIIC-g-8", "text": "Which era is called the 'Age of Mammals'?", "options": [{"key":"a","label":"Paleozoic","correct":false},{"key":"b","label":"Mesozoic","correct":false},{"key":"c","label":"Cenozoic","correct":true},{"key":"d","label":"Precambrian","correct":false}] },
    { "id": "st2-16", "competency": "STEM_BIO11/12-IIIC-g-9", "text": "The bottleneck effect is an example of:", "options": [{"key":"a","label":"Natural selection","correct":false},{"key":"b","label":"Genetic drift","correct":true},{"key":"c","label":"Mutation","correct":false},{"key":"d","label":"Gene flow","correct":false}] },
    { "id": "st2-17", "competency": "STEM_BIO11/12-IIIC-g-9", "text": "Which mechanism introduces NEW alleles into a population?", "options": [{"key":"a","label":"Mutation","correct":true},{"key":"b","label":"Genetic drift","correct":false},{"key":"c","label":"Natural selection","correct":false},{"key":"d","label":"Gene flow out","correct":false}] },
    { "id": "st2-18", "competency": "STEM_BIO11/12-IIIC-g-10", "text": "Vestigial structures are evidence of:", "options": [{"key":"a","label":"Recent adaptation","correct":false},{"key":"b","label":"Common ancestry","correct":true},{"key":"c","label":"Convergent evolution","correct":false},{"key":"d","label":"Genetic drift","correct":false}] },
    { "id": "st2-19", "competency": "STEM_BIO11/12-IIIC-g-11", "text": "Who first proposed that species change over time through inheritance of acquired characteristics?", "options": [{"key":"a","label":"Darwin","correct":false},{"key":"b","label":"Lamarck","correct":true},{"key":"c","label":"Wallace","correct":false},{"key":"d","label":"Malthus","correct":false}] },
    { "id": "st2-20", "competency": "STEM_BIO11/12-IIIC-g-11", "text": "Darwin's key observation came from his voyage on the:", "options": [{"key":"a","label":"HMS Beagle","correct":true},{"key":"b","label":"HMS Victory","correct":false},{"key":"c","label":"Santa Maria","correct":false},{"key":"d","label":"Mayflower","correct":false}] },
    { "id": "st2-21", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "Analogous structures indicate:", "options": [{"key":"a","label":"Common ancestry","correct":false},{"key":"b","label":"Convergent evolution","correct":true},{"key":"c","label":"Random mutation","correct":false},{"key":"d","label":"Genetic drift","correct":false}] },
    { "id": "st2-22", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "DNA sequence comparisons provide evidence for:", "options": [{"key":"a","label":"Common ancestry","correct":true},{"key":"b","label":"Spontaneous generation","correct":false},{"key":"c","label":"Creationism","correct":false},{"key":"d","label":"Convergent evolution only","correct":false}] },
    { "id": "st2-23", "competency": "STEM_BIO11/12-IIIC-g-13", "text": "Biogeography studies:", "options": [{"key":"a","label":"Geographic distribution of species","correct":true},{"key":"b","label":"Fossil ages only","correct":false},{"key":"c","label":"DNA sequences","correct":false},{"key":"d","label":"Embryos","correct":false}] },
    { "id": "st2-24", "competency": "STEM_BIO11/12-IIIH-j-14", "text": "The three-domain system includes:", "options": [{"key":"a","label":"Bacteria, Archaea, Eukarya","correct":true},{"key":"b","label":"Plants, Animals, Fungi","correct":false},{"key":"c","label":"Protists, Fungi, Plants","correct":false},{"key":"d","label":"Monera, Protista, Animalia","correct":false}] },
    { "id": "st2-25", "competency": "STEM_BIO11/12-IIIH-j-14", "text": "Which molecule is most commonly used to infer evolutionary relationships?", "options": [{"key":"a","label":"rRNA","correct":true},{"key":"b","label":"Lipids","correct":false},{"key":"c","label":"Cellulose","correct":false},{"key":"d","label":"Starch","correct":false}] },
    { "id": "st2-26", "competency": "STEM_BIO11/12-IIIH-j-15", "text": "Binomial nomenclature uses:", "options": [{"key":"a","label":"Genus + species","correct":true},{"key":"b","label":"Family + genus","correct":false},{"key":"c","label":"Kingdom + phylum","correct":false},{"key":"d","label":"Two common names","correct":false}] },
    { "id": "st2-27", "competency": "STEM_BIO11/12-IIIH-j-15", "text": "Which is a correct way to write a scientific name?", "options": [{"key":"a","label":"Homo sapiens (italic, genus capitalized)","correct":true},{"key":"b","label":"homo Sapiens","correct":false},{"key":"c","label":"HOMO SAPIENS","correct":false},{"key":"d","label":"Homo Sapiens","correct":false}] },
    { "id": "st2-28", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "Cladistics groups organisms by:", "options": [{"key":"a","label":"Shared derived characteristics","correct":true},{"key":"b","label":"Random features","correct":false},{"key":"c","label":"Size","correct":false},{"key":"d","label":"Color","correct":false}] },
    { "id": "st2-29", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "A cladogram shows:", "options": [{"key":"a","label":"Evolutionary relationships","correct":true},{"key":"b","label":"Food chains","correct":false},{"key":"c","label":"Genetic diseases","correct":false},{"key":"d","label":"Embryo development","correct":false}] },
    { "id": "st2-30", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "Species diversity is highest in:", "options": [{"key":"a","label":"Tropical rainforests","correct":true},{"key":"b","label":"Deserts","correct":false},{"key":"c","label":"Polar regions","correct":false},{"key":"d","label":"Temperate grasslands","correct":false}] }
  ]
}