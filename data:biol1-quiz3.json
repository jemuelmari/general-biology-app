  "items": [
    { "id": "q3-01", "competency": "STEM_BIO11/12-IIa-j-4", "text": "Where do the light reactions occur?", "options": [{"key":"a","label":"Stroma","correct":false},{"key":"b","label":"Thylakoid membrane","correct":true},{"key":"c","label":"Cytoplasm","correct":false},{"key":"d","label":"Mitochondria","correct":false}] },
    { "id": "q3-02", "competency": "STEM_BIO11/12-IIa-j-4", "text": "Which photosystem splits water?", "options": [{"key":"a","label":"Photosystem I","correct":false},{"key":"b","label":"Photosystem II","correct":true},{"key":"c","label":"Both","correct":false},{"key":"d","label":"Neither","correct":false}] },
    { "id": "q3-03", "competency": "STEM_BIO11/12-IIa-j-4", "text": "O₂ released during photosynthesis comes from:", "options": [{"key":"a","label":"CO₂","correct":false},{"key":"b","label":"Glucose","correct":false},{"key":"c","label":"Water","correct":true},{"key":"d","label":"ATP","correct":false}] },
    { "id": "q3-04", "competency": "STEM_BIO11/12-IIa-j-5", "text": "What is the primary enzyme of carbon fixation?", "options": [{"key":"a","label":"ATP synthase","correct":false},{"key":"b","label":"RuBisCO","correct":true},{"key":"c","label":"Hexokinase","correct":false},{"key":"d","label":"Pepsin","correct":false}] },
    { "id": "q3-05", "competency": "STEM_BIO11/12-IIa-j-5", "text": "Where does the Calvin cycle take place?", "options": [{"key":"a","label":"Thylakoid","correct":false},{"key":"b","label":"Stroma","correct":true},{"key":"c","label":"Cytoplasm","correct":false},{"key":"d","label":"Nucleus","correct":false}] },
    { "id": "q3-06", "competency": "STEM_BIO11/12-IIa-j-5", "text": "The Calvin cycle uses how many ATP per CO₂ fixed?", "options": [{"key":"a","label":"1","correct":false},{"key":"b","label":"2","correct":false},{"key":"c","label":"3","correct":true},{"key":"d","label":"4","correct":false}] },
    { "id": "q3-07", "competency": "STEM_BIO11/12-IIa-j-6", "text": "Which process produces ethanol?", "options": [{"key":"a","label":"Lactic acid fermentation","correct":false},{"key":"b","label":"Alcoholic fermentation","correct":true},{"key":"c","label":"Aerobic respiration","correct":false},{"key":"d","label":"Photosynthesis","correct":false}] },
    { "id": "q3-08", "competency": "STEM_BIO11/12-IIa-j-6", "text": "Which produces the most ATP per glucose?", "options": [{"key":"a","label":"Fermentation","correct":false},{"key":"b","label":"Aerobic respiration","correct":true},{"key":"c","label":"Glycolysis","correct":false},{"key":"d","label":"Lactic acid fermentation","correct":false}] },
    { "id": "q3-09", "competency": "STEM_BIO11/12-IIa-j-7", "text": "Where does glycolysis occur?", "options": [{"key":"a","label":"Cytoplasm","correct":true},{"key":"b","label":"Mitochondria","correct":false},{"key":"c","label":"Nucleus","correct":false},{"key":"d","label":"Chloroplast","correct":false}] },
    { "id": "q3-10", "competency": "STEM_BIO11/12-IIa-j-7", "text": "Products of glycolysis per glucose:", "options": [{"key":"a","label":"2 pyruvate, 2 ATP, 2 NADH","correct":true},{"key":"b","label":"1 pyruvate, 4 ATP","correct":false},{"key":"c","label":"6 CO₂, 2 ATP","correct":false},{"key":"d","label":"2 glucose, 4 ATP","correct":false}] },
    { "id": "q3-11", "competency": "STEM_BIO11/12-IIa-j-8", "text": "Where does the Krebs cycle occur?", "options": [{"key":"a","label":"Cytoplasm","correct":false},{"key":"b","label":"Mitochondrial matrix","correct":true},{"key":"c","label":"Thylakoid","correct":false},{"key":"d","label":"Nucleus","correct":false}] },
    { "id": "q3-12", "competency": "STEM_BIO11/12-IIa-j-8", "text": "How many NADH are produced per turn of the Krebs cycle?", "options": [{"key":"a","label":"1","correct":false},{"key":"b","label":"2","correct":false},{"key":"c","label":"3","correct":true},{"key":"d","label":"4","correct":false}] },
    { "id": "q3-13", "competency": "STEM_BIO11/12-IIa-j-8", "text": "Where does the electron transport chain occur?", "options": [{"key":"a","label":"Inner mitochondrial membrane","correct":true},{"key":"b","label":"Cytoplasm","correct":false},{"key":"c","label":"Nucleus","correct":false},{"key":"d","label":"Chloroplast","correct":false}] },
    { "id": "q3-14", "competency": "STEM_BIO11/12-IIa-j-8", "text": "Which produces the most ATP?", "options": [{"key":"a","label":"Glycolysis","correct":false},{"key":"b","label":"Krebs cycle","correct":false},{"key":"c","label":"Electron transport chain","correct":true},{"key":"d","label":"Fermentation","correct":false}] },
    { "id": "q3-15", "competency": "STEM_BIO11/12-IIa-j-9", "text": "How many ATP does each NADH yield (modern estimate)?", "options": [{"key":"a","label":"1.5","correct":false},{"key":"b","label":"2.5","correct":true},{"key":"c","label":"3","correct":false},{"key":"d","label":"4","correct":false}] },
    { "id": "q3-16", "competency": "STEM_BIO11/12-IIa-j-9", "text": "How many ATP does each FADH₂ yield (modern estimate)?", "options": [{"key":"a","label":"1.5","correct":true},{"key":"b","label":"2.5","correct":false},{"key":"c","label":"3","correct":false},{"key":"d","label":"4","correct":false}] },
    { "id": "q3-17", "competency": "STEM_BIO11/12-IIa-j-9", "text": "Modern total ATP yield per glucose (aerobic):", "options": [{"key":"a","label":"18","correct":false},{"key":"b","label":"30","correct":false},{"key":"c","label":"32","correct":true},{"key":"d","label":"38","correct":false}] },
    { "id": "q3-18", "competency": "STEM_BIO11/12-IIa-j-10", "text": "What is the final electron acceptor in aerobic respiration?", "options": [{"key":"a","label":"NAD⁺","correct":false},{"key":"b","label":"O₂","correct":true},{"key":"c","label":"FAD","correct":false},{"key":"d","label":"ATP","correct":false}] },
    { "id": "q3-19", "competency": "STEM_BIO11/12-IIa-j-11", "text": "How many ATP are needed to make 2 glucose in the Calvin cycle?", "options": [{"key":"a","label":"18","correct":false},{"key":"b","label":"36","correct":true},{"key":"c","label":"54","correct":false},{"key":"d","label":"72","correct":false}] },
    { "id": "q3-20", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which is a disadvantage of fermentation?", "options": [{"key":"a","label":"Requires oxygen","correct":false},{"key":"b","label":"Low ATP yield","correct":true},{"key":"c","label":"Very slow","correct":false},{"key":"d","label":"Produces O₂","correct":false}] }
  ]
