  "title": "Quiz 3 — Evolution, Systematics & Taxonomy",
  "timeLimit": 1200,
  "passingScore": 80,
  "items": [
    { "id": "q3-01", "competency": "STEM_BIO11/12-IIIC-g-8", "text": "Which era is known as the 'Age of Reptiles'?", "options": [{"key":"a","label":"Precambrian","correct":false},{"key":"b","label":"Paleozoic","correct":false},{"key":"c","label":"Mesozoic","correct":true},{"key":"d","label":"Cenozoic","correct":false}] },
    { "id": "q3-02", "competency": "STEM_BIO11/12-IIIC-g-8", "text": "Which era is called the 'Age of Mammals'?", "options": [{"key":"a","label":"Precambrian","correct":false},{"key":"b","label":"Paleozoic","correct":false},{"key":"c","label":"Mesozoic","correct":false},{"key":"d","label":"Cenozoic","correct":true}] },
    { "id": "q3-03", "competency": "STEM_BIO11/12-IIIC-g-9", "text": "Genetic drift is:", "options": [{"key":"a","label":"Random","correct":true},{"key":"b","label":"Directional","correct":false},{"key":"c","label":"Predictable","correct":false},{"key":"d","label":"Adaptive","correct":false}] },
    { "id": "q3-04", "competency": "STEM_BIO11/12-IIIC-g-9", "text": "Which is the only source of NEW alleles?", "options": [{"key":"a","label":"Mutation","correct":true},{"key":"b","label":"Recombination","correct":false},{"key":"c","label":"Selection","correct":false},{"key":"d","label":"Gene flow","correct":false}] },
    { "id": "q3-05", "competency": "STEM_BIO11/12-IIIC-g-9", "text": "Natural selection acts on:", "options": [{"key":"a","label":"Genotypes","correct":false},{"key":"b","label":"Phenotypes","correct":true},{"key":"c","label":"Chromosomes","correct":false},{"key":"d","label":"Gametes","correct":false}] },
    { "id": "q3-06", "competency": "STEM_BIO11/12-IIIC-g-9", "text": "Which type of selection favors the average?", "options": [{"key":"a","label":"Directional","correct":false},{"key":"b","label":"Stabilizing","correct":true},{"key":"c","label":"Disruptive","correct":false},{"key":"d","label":"Artificial","correct":false}] },
    { "id": "q3-07", "competency": "STEM_BIO11/12-IIIC-g-10", "text": "Descent with modification means:", "options": [{"key":"a","label":"Species are fixed","correct":false},{"key":"b","label":"Species change over time and share ancestors","correct":true},{"key":"c","label":"All life is unrelated","correct":false},{"key":"d","label":"Evolution is random","correct":false}] },
    { "id": "q3-08", "competency": "STEM_BIO11/12-IIIC-g-11", "text": "Who proposed natural selection?", "options": [{"key":"a","label":"Lamarck","correct":false},{"key":"b","label":"Darwin","correct":true},{"key":"c","label":"Linnaeus","correct":false},{"key":"d","label":"Mendel","correct":false}] },
    { "id": "q3-09", "competency": "STEM_BIO11/12-IIIC-g-11", "text": "Lamarck proposed:", "options": [{"key":"a","label":"Natural selection","correct":false},{"key":"b","label":"Inheritance of acquired characteristics","correct":true},{"key":"c","label":"Common ancestry","correct":false},{"key":"d","label":"Mutation","correct":false}] },
    { "id": "q3-10", "competency": "STEM_BIO11/12-IIIC-g-11", "text": "On the Origin of Species was published in:", "options": [{"key":"a","label":"1758","correct":false},{"key":"b","label":"1859","correct":true},{"key":"c","label":"1900","correct":false},{"key":"d","label":"1953","correct":false}] },
    { "id": "q3-11", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "Homologous structures provide evidence for:", "options": [{"key":"a","label":"Convergent evolution","correct":false},{"key":"b","label":"Common ancestry","correct":true},{"key":"c","label":"Spontaneous generation","correct":false},{"key":"d","label":"Genetic drift","correct":false}] },
    { "id": "q3-12", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "Vestigial structures are:", "options": [{"key":"a","label":"Newly evolved","correct":false},{"key":"b","label":"Reduced in function","correct":true},{"key":"c","label":"Only in plants","correct":false},{"key":"d","label":"Always harmful","correct":false}] },
    { "id": "q3-13", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "The fossil record shows:", "options": [{"key":"a","label":"Evolutionary change over time","correct":true},{"key":"b","label":"Creationism","correct":false},{"key":"c","label":"Spontaneous generation","correct":false},{"key":"d","label":"Intelligent design","correct":false}] },
    { "id": "q3-14", "competency": "STEM_BIO11/12-IIIC-g-13", "text": "Two species that share more DNA are:", "options": [{"key":"a","label":"More closely related","correct":true},{"key":"b","label":"Less related","correct":false},{"key":"c","label":"Unrelated","correct":false},{"key":"d","label":"Identical","correct":false}] },
    { "id": "q3-15", "competency": "STEM_BIO11/12-IIIC-g-13", "text": "A node on a phylogenetic tree represents:", "options": [{"key":"a","label":"A common ancestor","correct":true},{"key":"b","label":"A modern species","correct":false},{"key":"c","label":"A mutation","correct":false},{"key":"d","label":"An extinction event","correct":false}] },
    { "id": "q3-16", "competency": "STEM_BIO11/12-IIIH-j-14", "text": "Binomial nomenclature was developed by:", "options": [{"key":"a","label":"Darwin","correct":false},{"key":"b","label":"Linnaeus","correct":true},{"key":"c","label":"Mendel","correct":false},{"key":"d","label":"Lamarck","correct":false}] },
    { "id": "q3-17", "competency": "STEM_BIO11/12-IIIH-j-14", "text": "The largest taxonomic rank is:", "options": [{"key":"a","label":"Kingdom","correct":false},{"key":"b","label":"Domain","correct":true},{"key":"c","label":"Phylum","correct":false},{"key":"d","label":"Class","correct":false}] },
    { "id": "q3-18", "competency": "STEM_BIO11/12-IIIH-j-15", "text": "Which kingdom has chitin cell walls?", "options": [{"key":"a","label":"Plantae","correct":false},{"key":"b","label":"Fungi","correct":true},{"key":"c","label":"Animalia","correct":false},{"key":"d","label":"Protista","correct":false}] },
    { "id": "q3-19", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "Cladistics groups organisms by:", "options": [{"key":"a","label":"Shared derived characteristics","correct":true},{"key":"b","label":"Color","correct":false},{"key":"c","label":"Size","correct":false},{"key":"d","label":"Habitat","correct":false}] },
    { "id": "q3-20", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "A monophyletic group includes:", "options": [{"key":"a","label":"Ancestor + all descendants","correct":true},{"key":"b","label":"Only living species","correct":false},{"key":"c","label":"Only derived traits","correct":false},{"key":"d","label":"Ancestor only","correct":false}] }
  ]
}
