        { "key": "b", "label": "Circulatory", "correct": true },
        { "key": "c", "label": "Digestive", "correct": false },
        { "key": "d", "label": "Endocrine", "correct": false }
      ]
    },
    {
      "id": "st1-02",
      "competency": "STEM_BIO11/12-IVa-h-1",
