{
  "assessmentId": "biol2-te",
  "subject": "biol2",
  "type": "te",
  "title": "Term Exam — Evolution Evidence & Systematics (Weeks 9–10)",
  "timeLimit": 3600,
  "passingScore": 80,
  "items": [
    { "id": "te-01", "competency": "STEM_BIO11/12-IIIC-g-10", "text": "Descent with modification means:", "options": [{"key":"a","label":"Species change over time and share ancestors","correct":true},{"key":"b","label":"Species are fixed","correct":false},{"key":"c","label":"Life is unrelated","correct":false},{"key":"d","label":"Evolution is random","correct":false}] },
    { "id": "te-02", "competency": "STEM_BIO11/12-IIIC-g-10", "text": "All life shares which fundamental molecules?", "options": [{"key":"a","label":"DNA, ribosomes, ATP","correct":true},{"key":"b","label":"Chlorophyll only","correct":false},{"key":"c","label":"Cellulose only","correct":false},{"key":"d","label":"Keratin","correct":false}] },
    { "id": "te-03", "competency": "STEM_BIO11/12-IIIC-g-10", "text": "A phylogenetic tree shows:", "options": [{"key":"a","label":"Evolutionary relationships","correct":true},{"key":"b","label":"Food chains","correct":false},{"key":"c","label":"Genetic diseases","correct":false},{"key":"d","label":"Cell division","correct":false}] },
    { "id": "te-04", "competency": "STEM_BIO11/12-IIIC-g-10", "text": "Speciation refers to:", "options": [{"key":"a","label":"Extinction","correct":false},{"key":"b","label":"Formation of new species","correct":true},{"key":"c","label":"Mutation","correct":false},{"key":"d","label":"Migration","correct":false}] },
    { "id": "te-05", "competency": "STEM_BIO11/12-IIIC-g-11", "text": "Which scientist proposed the inheritance of acquired characteristics?", "options": [{"key":"a","label":"Darwin","correct":false},{"key":"b","label":"Lamarck","correct":true},{"key":"c","label":"Mendel","correct":false},{"key":"d","label":"Wallace","correct":false}] },
    { "id": "te-06", "competency": "STEM_BIO11/12-IIIC-g-11", "text": "Darwin's main contribution was:", "options": [{"key":"a","label":"Binomial nomenclature","correct":false},{"key":"b","label":"Natural selection","correct":true},{"key":"c","label":"Genetics","correct":false},{"key":"d","label":"Cell theory","correct":false}] },
    { "id": "te-07", "competency": "STEM_BIO11/12-IIIC-g-11", "text": "On the Origin of Species was published in:", "options": [{"key":"a","label":"1759","correct":false},{"key":"b","label":"1859","correct":true},{"key":"c","label":"1900","correct":false},{"key":"d","label":"1953","correct":false}] },
    { "id": "te-08", "competency": "STEM_BIO11/12-IIIC-g-11", "text": "Darwin's voyage was on the:", "options": [{"key":"a","label":"HMS Beagle","correct":true},{"key":"b","label":"HMS Victory","correct":false},{"key":"c","label":"Santa Maria","correct":false},{"key":"d","label":"Mayflower","correct":false}] },
    { "id": "te-09", "competency": "STEM_BIO11/12-IIIC-g-11", "text": "Modern synthesis combines Darwinism with:", "options": [{"key":"a","label":"Genetics","correct":true},{"key":"b","label":"Lamarckism","correct":false},{"key":"c","label":"Creationism","correct":false},{"key":"d","label":"Cell theory","correct":false}] },
    { "id": "te-10", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "Homologous structures indicate:", "options": [{"key":"a","label":"Convergent evolution","correct":false},{"key":"b","label":"Common ancestry","correct":true},{"key":"c","label":"Random mutation","correct":false},{"key":"d","label":"Spontaneous generation","correct":false}] },
    { "id": "te-11", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "Vestigial structures are:", "options": [{"key":"a","label":"Newly evolved","correct":false},{"key":"b","label":"Reduced in function","correct":true},{"key":"c","label":"Only in plants","correct":false},{"key":"d","label":"Always harmful","correct":false}] },
    { "id": "te-12", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "The fossil record shows:", "options": [{"key":"a","label":"Evolutionary change over time","correct":true},{"key":"b","label":"Static species","correct":false},{"key":"c","label":"Spontaneous generation","correct":false},{"key":"d","label":"Random chance only","correct":false}] },
    { "id": "te-13", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "Molecular evidence for evolution includes:", "options": [{"key":"a","label":"DNA sequence similarities","correct":true},{"key":"b","label":"Coloration only","correct":false},{"key":"c","label":"Habitat","correct":false},{"key":"d","label":"Size","correct":false}] },
    { "id": "te-14", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "Comparative embryology shows:", "options": [{"key":"a","label":"Embryos of related species are similar","correct":true},{"key":"b","label":"Embryos are unrelated","correct":false},{"key":"c","label":"Only mammals have embryos","correct":false},{"key":"d","label":"Embryos don't change","correct":false}] },
    { "id": "te-15", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "Biogeography studies:", "options": [{"key":"a","label":"Geographic distribution of species","correct":true},{"key":"b","label":"Fossil ages","correct":false},{"key":"c","label":"DNA sequences","correct":false},{"key":"d","label":"Cell structure","correct":false}] },
    { "id": "te-16", "competency": "STEM_BIO11/12-IIIC-g-13", "text": "Two species with more DNA in common are:", "options": [{"key":"a","label":"More closely related","correct":true},{"key":"b","label":"Less related","correct":false},{"key":"c","label":"Unrelated","correct":false},{"key":"d","label":"Identical","correct":false}] },
    { "id": "te-17", "competency": "STEM_BIO11/12-IIIC-g-13", "text": "A node on a phylogenetic tree represents:", "options": [{"key":"a","label":"A common ancestor","correct":true},{"key":"b","label":"A modern species","correct":false},{"key":"c","label":"A mutation","correct":false},{"key":"d","label":"An extinction","correct":false}] },
    { "id": "te-18", "competency": "STEM_BIO11/12-IIIC-g-13", "text": "A molecular clock uses:", "options": [{"key":"a","label":"DNA differences to estimate time","correct":true},{"key":"b","label":"Fossil size","correct":false},{"key":"c","label":"Color change","correct":false},{"key":"d","label":"Behavior","correct":false}] },
    { "id": "te-19", "competency": "STEM_BIO11/12-IIIC-g-13", "text": "A clade includes:", "options": [{"key":"a","label":"Ancestor + all descendants","correct":true},{"key":"b","label":"Only living species","correct":false},{"key":"c","label":"Only derived traits","correct":false},{"key":"d","label":"Ancestor only","correct":false}] },
    { "id": "te-20", "competency": "STEM_BIO11/12-IIIC-g-13", "text": "Which of the following is NOT evidence for evolution?", "options": [{"key":"a","label":"Homologous structures","correct":false},{"key":"b","label":"Fossil record","correct":false},{"key":"c","label":"DNA similarities","correct":false},{"key":"d","label":"Spontaneous generation","correct":true}] },
    { "id": "te-21", "competency": "STEM_BIO11/12-IIIH-j-14", "text": "Binomial nomenclature was developed by:", "options": [{"key":"a","label":"Darwin","correct":false},{"key":"b","label":"Linnaeus","correct":true},{"key":"c","label":"Mendel","correct":false},{"key":"d","label":"Lamarck","correct":false}] },
    { "id": "te-22", "competency": "STEM_BIO11/12-IIIH-j-14", "text": "The correct format for a scientific name:", "options": [{"key":"a","label":"Homo sapiens (italic)","correct":true},{"key":"b","label":"homo sapiens","correct":false},{"key":"c","label":"HOMO SAPIENS","correct":false},{"key":"d","label":"Homo Sapiens","correct":false}] },
    { "id": "te-23", "competency": "STEM_BIO11/12-IIIH-j-14", "text": "The largest taxonomic rank is:", "options": [{"key":"a","label":"Kingdom","correct":false},{"key":"b","label":"Domain","correct":true},{"key":"c","label":"Phylum","correct":false},{"key":"d","label":"Class","correct":false}] },
    { "id": "te-24", "competency": "STEM_BIO11/12-IIIH-j-14", "text": "Which domains are prokaryotic?", "options": [{"key":"a","label":"Bacteria and Archaea","correct":true},{"key":"b","label":"Eukarya only","correct":false},{"key":"c","label":"Protista and Fungi","correct":false},{"key":"d","label":"Plantae and Animalia","correct":false}] },
    { "id": "te-25", "competency": "STEM_BIO11/12-IIIH-j-14", "text": "Which scheme does modern biology prefer?", "options": [{"key":"a","label":"3-Domain","correct":true},{"key":"b","label":"5-Kingdom","correct":false},{"key":"c","label":"2-Kingdom","correct":false},{"key":"d","label":"6-Kingdom","correct":false}] },
    { "id": "te-26", "competency": "STEM_BIO11/12-IIIH-j-15", "text": "Which kingdom has chitin cell walls?", "options": [{"key":"a","label":"Plantae","correct":false},{"key":"b","label":"Fungi","correct":true},{"key":"c","label":"Animalia","correct":false},{"key":"d","label":"Protista","correct":false}] },
    { "id": "te-27", "competency": "STEM_BIO11/12-IIIH-j-15", "text": "Which kingdom has NO cell wall?", "options": [{"key":"a","label":"Plantae","correct":false},{"key":"b","label":"Fungi","correct":false},{"key":"c","label":"Animalia","correct":true},{"key":"d","label":"Monera","correct":false}] },
    { "id": "te-28", "competency": "STEM_BIO11/12-IIIH-j-15", "text": "Which kingdom is autotrophic?", "options": [{"key":"a","label":"Fungi","correct":false},{"key":"b","label":"Animalia","correct":false},{"key":"c","label":"Plantae","correct":true},{"key":"d","label":"Protista only","correct":false}] },
    { "id": "te-29", "competency": "STEM_BIO11/12-IIIH-j-15", "text": "A taxon is:", "options": [{"key":"a","label":"A group at any taxonomic level","correct":true},{"key":"b","label":"A species only","correct":false},{"key":"c","label":"A gene","correct":false},{"key":"d","label":"A fossil","correct":false}] },
    { "id": "te-30", "competency": "STEM_BIO11/12-IIIH-j-15", "text": "Convergent evolution produces:", "options": [{"key":"a","label":"Analogous structures","correct":true},{"key":"b","label":"Homologous structures","correct":false},{"key":"c","label":"Vestigial structures","correct":false},{"key":"d","label":"Derived traits","correct":false}] },
    { "id": "te-31", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "Cladistics groups organisms by:", "options": [{"key":"a","label":"Shared derived characteristics","correct":true},{"key":"b","label":"Color","correct":false},{"key":"c","label":"Size","correct":false},{"key":"d","label":"Habitat","correct":false}] },
    { "id": "te-32", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "A monophyletic group includes:", "options": [{"key":"a","label":"Ancestor + all descendants","correct":true},{"key":"b","label":"Only living species","correct":false},{"key":"c","label":"Only derived traits","correct":false},{"key":"d","label":"Ancestor only","correct":false}] },
    { "id": "te-33", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "An outgroup is:", "options": [{"key":"a","label":"A reference taxon outside the study group","correct":true},{"key":"b","label":"A modern species","correct":false},{"key":"c","label":"A derived trait","correct":false},{"key":"d","label":"A node","correct":false}] },
    { "id": "te-34", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "Species richness refers to:", "options": [{"key":"a","label":"Number of species","correct":true},{"key":"b","label":"Distribution of individuals","correct":false},{"key":"c","label":"Size of organisms","correct":false},{"key":"d","label":"Genetic diversity","correct":false}] },
    { "id": "te-35", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "A shared derived trait is called:", "options": [{"key":"a","label":"Synapomorphy","correct":true},{"key":"b","label":"Plesiomorphy","correct":false},{"key":"c","label":"Apomorphy only","correct":false},{"key":"d","label":"Homoplasy","correct":false}] },
    { "id": "te-36", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "The highest species diversity is found in:", "options": [{"key":"a","label":"Tropical rainforests","correct":true},{"key":"b","label":"Deserts","correct":false},{"key":"c","label":"Polar regions","correct":false},{"key":"d","label":"Temperate grasslands","correct":false}] },
    { "id": "te-37", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "First step in constructing a cladogram:", "options": [{"key":"a","label":"Choose the group of interest","correct":true},{"key":"b","label":"Draw nodes","correct":false},{"key":"c","label":"Choose an outgroup","correct":false},{"key":"d","label":"Mark traits","correct":false}] },
    { "id": "te-38", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "A paraphyletic group:", "options": [{"key":"a","label":"Excludes some descendants of the ancestor","correct":true},{"key":"b","label":"Includes all descendants","correct":false},{"key":"c","label":"Has no ancestor","correct":false},{"key":"d","label":"Contains only fossils","correct":false}] },
    { "id": "te-39", "competency": "STEM_BIO11/12-IIIC-g-10", "text": "Which is the correct order of evolutionary relatedness?", "options": [{"key":"a","label":"More shared traits = closer relationship","correct":true},{"key":"b","label":"More traits = less related","correct":false},{"key":"c","label":"Traits don't matter","correct":false},{"key":"d","label":"Only DNA matters","correct":false}] },
    { "id": "te-40", "competency": "STEM_BIO11/12-IIIC-g-10", "text": "Homologous structures are evidence of:", "options": [{"key":"a","label":"Shared ancestry","correct":true},{"key":"b","label":"Convergent evolution","correct":false},{"key":"c","label":"Random chance","correct":false},{"key":"d","label":"Extinction","correct":false}] },
    { "id": "te-41", "competency": "STEM_BIO11/12-IIIC-g-11", "text": "Which scientist argued that populations grow faster than resources?", "options": [{"key":"a","label":"Malthus","correct":true},{"key":"b","label":"Darwin","correct":false},{"key":"c","label":"Lamarck","correct":false},{"key":"d","label":"Wallace","correct":false}] },
    { "id": "te-42", "competency": "STEM_BIO11/12-IIIC-g-11", "text": "Modern synthesis integrated Darwin's ideas with:", "options": [{"key":"a","label":"Mendelian genetics","correct":true},{"key":"b","label":"Lamarckism","correct":false},{"key":"c","label":"Spontaneous generation","correct":false},{"key":"d","label":"Cell theory","correct":false}] },
    { "id": "te-43", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "The fossil Archaeopteryx provides evidence of:", "options": [{"key":"a","label":"A transition between reptiles and birds","correct":true},{"key":"b","label":"Dinosaurs only","correct":false},{"key":"c","label":"Mammals only","correct":false},{"key":"d","label":"Fish only","correct":false}] },
    { "id": "te-44", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "Human and chimpanzee DNA is approximately:", "options": [{"key":"a","label":"98% identical","correct":true},{"key":"b","label":"50% identical","correct":false},{"key":"c","label":"25% identical","correct":false},{"key":"d","label":"5% identical","correct":false}] },
    { "id": "te-45", "competency": "STEM_BIO11/12-IIIC-g-13", "text": "Branch lengths on a phylogenetic tree can represent:", "options": [{"key":"a","label":"Time or amount of change","correct":true},{"key":"b","label":"Color only","correct":false},{"key":"c","label":"Size only","correct":false},{"key":"d","label":"Population count","correct":false}] },
    { "id": "te-46", "competency": "STEM_BIO11/12-IIIC-g-13", "text": "Which of the following is NOT a type of evidence used to build phylogenetic trees?", "options": [{"key":"a","label":"DNA sequences","correct":false},{"key":"b","label":"Fossil record","correct":false},{"key":"c","label":"Comparative anatomy","correct":false},{"key":"d","label":"Musical preference","correct":true}] },
    { "id": "te-47", "competency": "STEM_BIO11/12-IIIH-j-14", "text": "Which taxonomic rank is most inclusive after Domain?", "options": [{"key":"a","label":"Kingdom","correct":true},{"key":"b","label":"Phylum","correct":false},{"key":"c","label":"Class","correct":false},{"key":"d","label":"Genus","correct":false}] },
    { "id": "te-48", "competency": "STEM_BIO11/12-IIIH-j-14", "text": "Which of these is a correct species name?", "options": [{"key":"a","label":"Canis lupus (italic)","correct":true},{"key":"b","label":"canis Lupus","correct":false},{"key":"c","label":"CANIS LUPUS","correct":false},{"key":"d","label":"Canis lupus (bold)","correct":false}] },
    { "id": "te-49", "competency": "STEM_BIO11/12-IIIH-j-15", "text": "Which of the following kingdoms are eukaryotic?", "options": [{"key":"a","label":"Protista, Fungi, Plantae, Animalia","correct":true},{"key":"b","label":"Bacteria, Archaea","correct":false},{"key":"c","label":"Monera only","correct":false},{"key":"d","label":"None","correct":false}] },
    { "id": "te-50", "competency": "STEM_BIO11/12-IIIH-j-15", "text": "Kingdom Protista includes:", "options": [{"key":"a","label":"Mostly unicellular eukaryotes","correct":true},{"key":"b","label":"Only multicellular organisms","correct":false},{"key":"c","label":"Only prokaryotes","correct":false},{"key":"d","label":"Only animals","correct":false}] },
    { "id": "te-51", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "Which is the correct sequence from largest to smallest?", "options": [{"key":"a","label":"Domain → Kingdom → Phylum → Class → Order → Family → Genus → Species","correct":true},{"key":"b","label":"Species → Genus → Family → Order → Class → Phylum → Kingdom → Domain","correct":false},{"key":"c","label":"Kingdom → Domain → Species","correct":false},{"key":"d","label":"Phylum → Kingdom → Class","correct":false}] },
    { "id": "te-52", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "A cladogram's branching pattern is based on:", "options": [{"key":"a","label":"Shared derived traits","correct":true},{"key":"b","label":"Random guessing","correct":false},{"key":"c","label":"Color patterns","correct":false},{"key":"d","label":"Population size","correct":false}] },
    { "id": "te-53", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "Analogous structures result from:", "options": [{"key":"a","label":"Convergent evolution","correct":true},{"key":"b","label":"Common ancestry","correct":false},{"key":"c","label":"Shared derived traits","correct":false},{"key":"d","label":"Synapomorphies","correct":false}] },
    { "id": "te-54", "competency": "STEM_BIO11/12-IIIC-g-10", "text": "Which is NOT a mechanism of evolutionary change?", "options": [{"key":"a","label":"Natural selection","correct":false},{"key":"b","label":"Genetic drift","correct":false},{"key":"c","label":"Mutation","correct":false},{"key":"d","label":"Spontaneous generation","correct":true}] },
    { "id": "te-55", "competency": "STEM_BIO11/12-IIIC-g-12", "text": "Vestigial structures provide evidence of:", "options": [{"key":"a","label":"Evolutionary history","correct":true},{"key":"b","label":"Recent adaptation","correct":false},{"key":"c","label":"Creation","correct":false},{"key":"d","label":"Random chance","correct":false}] },
    { "id": "te-56", "competency": "STEM_BIO11/12-IIIH-j-14", "text": "Which scheme recognizes that Bacteria and Archaea are fundamentally different?", "options": [{"key":"a","label":"3-Domain","correct":true},{"key":"b","label":"5-Kingdom","correct":false},{"key":"c","label":"2-Kingdom","correct":false},{"key":"d","label":"4-Kingdom","correct":false}] },
    { "id": "te-57", "competency": "STEM_BIO11/12-IIIH-j-15", "text": "Fungi are heterotrophic and have:", "options": [{"key":"a","label":"Chitin cell walls","correct":true},{"key":"b","label":"Cellulose cell walls","correct":false},{"key":"c","label":"No cell walls","correct":false},{"key":"d","label":"Peptidoglycan walls","correct":false}] },
    { "id": "te-58", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "Which best describes a clade?", "options": [{"key":"a","label":"An ancestor and all its descendants","correct":true},{"key":"b","label":"Only the most recent species","correct":false},{"key":"c","label":"Only extinct species","correct":false},{"key":"d","label":"Only the derived traits","correct":false}] },
    { "id": "te-59", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "In a cladogram, the outgroup is used to:", "options": [{"key":"a","label":"Provide a reference for comparison","correct":true},{"key":"b","label":"Represent the newest species","correct":false},{"key":"c","label":"Add more branches","correct":false},{"key":"d","label":"Determine color","correct":false}] },
    { "id": "te-60", "competency": "STEM_BIO11/12-IIIH-j-16", "text": "Which statement best summarizes systematics?", "options": [{"key":"a","label":"It studies evolutionary relationships using all available evidence","correct":true},{"key":"b","label":"It names organisms only","correct":false},{"key":"c","label":"It examines fossils only","correct":false},{"key":"d","label":"It ignores molecular data","correct":false}] }
  ]
}
