        { "key": "a", "label": "A blend of the two traits", "correct": false },
        { "key": "b", "label": "Both traits expressed distinctly", "correct": true },
        { "key": "c", "label": "Only the dominant trait", "correct": false },
        { "key": "d", "label": "Only the recessive trait", "correct": false }
