        { "key": "a", "label": "Contains leaves, stems, and flowers", "correct": true },
        { "key": "b", "label": "Contains root hairs", "correct": false },
        { "key": "c", "label": "Contains gills", "correct": false },
        { "key": "d", "label": "Contains alveoli", "correct": false }
      ]
    },
    {
      "id": "q1-02",
      "competency": "STEM_BIO11/12-IVa-h-1",
      "text": "Which plant tissue transports water and minerals from roots to leaves?",
      "options": [
        { "key": "a", "label": "Phloem", "correct": false },
        { "key": "b", "label": "Xylem", "correct": true },
        { "key": "c", "label": "Epidermis", "correct": false },
        { "key": "d", "label": "Cambium", "correct": false }
