    },
    {
      "id": "q1-16",
      "competency": "STEM_BIO11/12-IIIa-b-2",
      "text": "Why are X-linked recessive disorders more common in males?",
      "options": [
        { "key": "a", "label": "Males have two X chromosomes", "correct": false },
        { "key": "b", "label": "Males have only one X chromosome, so one recessive allele is enough to express the disorder", "correct": true },
        { "key": "c", "label": "Males do not inherit X chromosomes", "correct": false },
        { "key": "d", "label": "Females are immune to X-linked disorders", "correct": false }
