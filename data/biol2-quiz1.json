        { "key": "a", "label": "Positive feedback", "correct": false },
        { "key": "b", "label": "Negative feedback", "correct": true },
        { "key": "c", "label": "Feedforward control", "correct": false },
        { "key": "d", "label": "Neutral feedback", "correct": false }
