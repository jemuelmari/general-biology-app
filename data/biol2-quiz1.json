        { "key": "b", "label": "3:1", "correct": true },
        { "key": "c", "label": "1:2:1", "correct": false },
        { "key": "d", "label": "9:3:3:1", "correct": false }
      ]
    },
    {
      "id": "q1-12",
      "competency": "STEM_BIO11/12-IIIa-b-1",
