  "type": "quiz",
  "title": "Quiz 2 — Biological Molecules, Enzymes & Photosynthesis",
  "timeLimit": 1200,
  "passingScore": 80,
  "items": [
    { "id": "q2-01", "competency": "STEM_BIO11/12-II-i-j-15", "text": "Which of the following is a monosaccharide?", "options": [{"key":"a","label":"Glucose","correct":true},{"key":"b","label":"Sucrose","correct":false},{"key":"c","label":"Starch","correct":false},{"key":"d","label":"Cellulose","correct":false}] },
    { "id": "q2-02", "competency": "STEM_BIO11/12-II-i-j-15", "text": "Which polysaccharide is found in plant cell walls?", "options": [{"key":"a","label":"Glycogen","correct":false},{"key":"b","label":"Cellulose","correct":true},{"key":"c","label":"Starch","correct":false},{"key":"d","label":"Chitin","correct":false}] },
    { "id": "q2-03", "competency": "STEM_BIO11/12-II-i-j-15", "text": "Triglycerides are composed of:", "options": [{"key":"a","label":"Amino acids","correct":false},{"key":"b","label":"Glycerol + 3 fatty acids","correct":true},{"key":"c","label":"Nucleotides","correct":false},{"key":"d","label":"Monosaccharides","correct":false}] },
    { "id": "q2-04", "competency": "STEM_BIO11/12-II-i-j-15", "text": "Which lipid forms the cell membrane?", "options": [{"key":"a","label":"Triglyceride","correct":false},{"key":"b","label":"Phospholipid","correct":true},{"key":"c","label":"Steroid","correct":false},{"key":"d","label":"Wax","correct":false}] },
    { "id": "q2-05", "competency": "STEM_BIO11/12-II-i-j-15", "text": "The monomer of proteins is:", "options": [{"key":"a","label":"Glucose","correct":false},{"key":"b","label":"Nucleotide","correct":false},{"key":"c","label":"Amino acid","correct":true},{"key":"d","label":"Fatty acid","correct":false}] },
    { "id": "q2-06", "competency": "STEM_BIO11/12-II-i-j-15", "text": "Which level of protein structure is the amino acid sequence?", "options": [{"key":"a","label":"Primary","correct":true},{"key":"b","label":"Secondary","correct":false},{"key":"c","label":"Tertiary","correct":false},{"key":"d","label":"Quaternary","correct":false}] },
    { "id": "q2-07", "competency": "STEM_BIO11/12-II-i-j-15", "text": "Which nitrogenous base is found in RNA but not DNA?", "options": [{"key":"a","label":"Thymine","correct":false},{"key":"b","label":"Uracil","correct":true},{"key":"c","label":"Adenine","correct":false},{"key":"d","label":"Guanine","correct":false}] },
    { "id": "q2-08", "competency": "STEM_BIO11/12-II-i-j-15", "text": "ATP stands for:", "options": [{"key":"a","label":"Adenosine triphosphate","correct":true},{"key":"b","label":"Adenine triphosphate","correct":false},{"key":"c","label":"Amino triphosphate","correct":false},{"key":"d","label":"Adenosine diphosphate","correct":false}] },
    { "id": "q2-09", "competency": "STEM_BIO11/12-II-i-j-17", "text": "The region where a substrate binds to an enzyme is the:", "options": [{"key":"a","label":"Allosteric site","correct":false},{"key":"b","label":"Active site","correct":true},{"key":"c","label":"Cofactor","correct":false},{"key":"d","label":"Holoenzyme","correct":false}] },
    { "id": "q2-10", "competency": "STEM_BIO11/12-II-i-j-17", "text": "The protein portion of an enzyme is called the:", "options": [{"key":"a","label":"Apoenzyme","correct":true},{"key":"b","label":"Cofactor","correct":false},{"key":"c","label":"Holoenzyme","correct":false},{"key":"d","label":"Substrate","correct":false}] },
    { "id": "q2-11", "competency": "STEM_BIO11/12-II-i-j-17", "text": "Which model describes the active site changing shape to fit the substrate?", "options": [{"key":"a","label":"Lock-and-key","correct":false},{"key":"b","label":"Induced fit","correct":true},{"key":"c","label":"Fluid mosaic","correct":false},{"key":"d","label":"Sandwich","correct":false}] },
    { "id": "q2-12", "competency": "STEM_BIO11/12-II-i-j-17", "text": "What happens to most enzymes at very high temperatures?", "options": [{"key":"a","label":"Speed up indefinitely","correct":false},{"key":"b","label":"Denature","correct":true},{"key":"c","label":"Become coenzymes","correct":false},{"key":"d","label":"Dissolve","correct":false}] },
    { "id": "q2-13", "competency": "STEM_BIO11/12-II-i-j-18", "text": "Oxidation is defined as:", "options": [{"key":"a","label":"Gain of electrons","correct":false},{"key":"b","label":"Loss of electrons","correct":true},{"key":"c","label":"Gain of protons","correct":false},{"key":"d","label":"Loss of neutrons","correct":false}] },
    { "id": "q2-14", "competency": "STEM_BIO11/12-II-i-j-18", "text": "When NAD⁺ accepts electrons, it is:", "options": [{"key":"a","label":"Oxidized","correct":false},{"key":"b","label":"Reduced","correct":true},{"key":"c","label":"Denatured","correct":false},{"key":"d","label":"Hydrolyzed","correct":false}] },
    { "id": "q2-15", "competency": "STEM_BIO11/12-IIa-j-1", "text": "ATP is produced primarily by which process in cells?", "options": [{"key":"a","label":"Hydrolysis","correct":false},{"key":"b","label":"Energy coupling","correct":false},{"key":"c","label":"Phosphorylation (substrate-level, oxidative, or photo-)","correct":true},{"key":"d","label":"Denaturation","correct":false}] },
    { "id": "q2-16", "competency": "STEM_BIO11/12-IIa-j-3", "text": "Which pigment is the primary photosynthetic pigment?", "options": [{"key":"a","label":"Chlorophyll a","correct":true},{"key":"b","label":"Chlorophyll b","correct":false},{"key":"c","label":"Carotenoid","correct":false},{"key":"d","label":"Xanthophyll","correct":false}] },
    { "id": "q2-17", "competency": "STEM_BIO11/12-IIa-j-4", "text": "Which photosystem splits water?", "options": [{"key":"a","label":"Photosystem I","correct":false},{"key":"b","label":"Photosystem II","correct":true},{"key":"c","label":"Both","correct":false},{"key":"d","label":"Neither","correct":false}] },
    { "id": "q2-18", "competency": "STEM_BIO11/12-IIa-j-5", "text": "What is the main enzyme of carbon fixation in the Calvin cycle?", "options": [{"key":"a","label":"ATP synthase","correct":false},{"key":"b","label":"RuBisCO","correct":true},{"key":"c","label":"Hexokinase","correct":false},{"key":"d","label":"Pepsin","correct":false}] },
    { "id": "q2-19", "competency": "STEM_BIO11/12-IIa-j-4", "text": "Where do the light reactions occur?", "options": [{"key":"a","label":"Stroma","correct":false},{"key":"b","label":"Thylakoid membrane","correct":true},{"key":"c","label":"Cytoplasm","correct":false},{"key":"d","label":"Mitochondria","correct":false}] },
    { "id": "q2-20", "competency": "STEM_BIO11/12-IIa-j-5", "text": "The Calvin cycle uses how much ATP and NADPH per CO₂ fixed?", "options": [{"key":"a","label":"3 ATP + 2 NADPH","correct":true},{"key":"b","label":"2 ATP + 3 NADPH","correct":false},{"key":"c","label":"1 ATP + 1 NADPH","correct":false},{"key":"d","label":"4 ATP + 4 NADPH","correct":false}] }
  ]
}
