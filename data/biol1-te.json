{
  "assessmentId": "biol1-te",
  "subject": "biol1",
  "type": "te",
  "title": "Term Exam — ATP, Oxygen's Role & Fermentation (Weeks 9–10)",
  "timeLimit": 3600,
  "passingScore": 80,
  "items": [
    { "id": "te-01", "competency": "STEM_BIO11/12-IIa-j-9", "text": "Which process produces ATP directly using a phosphate group transfer?", "options": [{"key":"a","label":"Substrate-level phosphorylation","correct":true},{"key":"b","label":"Oxidative phosphorylation","correct":false},{"key":"c","label":"Photophosphorylation","correct":false},{"key":"d","label":"Hydrolysis","correct":false}] },
    { "id": "te-02", "competency": "STEM_BIO11/12-IIa-j-9", "text": "The Calvin cycle uses ATP and NADPH in a ratio of:", "options": [{"key":"a","label":"3:2","correct":true},{"key":"b","label":"2:3","correct":false},{"key":"c","label":"1:1","correct":false},{"key":"d","label":"4:1","correct":false}] },
    { "id": "te-03", "competency": "STEM_BIO11/12-IIa-j-9", "text": "Total ATP consumed to make one glucose in photosynthesis:", "options": [{"key":"a","label":"12","correct":false},{"key":"b","label":"18","correct":true},{"key":"c","label":"32","correct":false},{"key":"d","label":"36","correct":false}] },
    { "id": "te-04", "competency": "STEM_BIO11/12-IIa-j-9", "text": "In cellular respiration, how many ATP are produced by substrate-level phosphorylation (glycolysis + Krebs)?", "options": [{"key":"a","label":"2","correct":false},{"key":"b","label":"4","correct":true},{"key":"c","label":"28","correct":false},{"key":"d","label":"32","correct":false}] },
    { "id": "te-05", "competency": "STEM_BIO11/12-IIa-j-9", "text": "Which reaction consumes ATP?", "options": [{"key":"a","label":"Glycolysis","correct":false},{"key":"b","label":"Krebs cycle","correct":false},{"key":"c","label":"Na⁺/K⁺ pump","correct":true},{"key":"d","label":"ETC","correct":false}] },
    { "id": "te-06", "competency": "STEM_BIO11/12-IIa-j-9", "text": "Which reaction produces ATP?", "options": [{"key":"a","label":"Calvin cycle","correct":false},{"key":"b","label":"Protein synthesis","correct":false},{"key":"c","label":"Krebs cycle","correct":true},{"key":"d","label":"Muscle contraction","correct":false}] },
    { "id": "te-07", "competency": "STEM_BIO11/12-IIa-j-10", "text": "The final electron acceptor in aerobic respiration is:", "options": [{"key":"a","label":"NAD⁺","correct":false},{"key":"b","label":"O₂","correct":true},{"key":"c","label":"FAD","correct":false},{"key":"d","label":"ATP","correct":false}] },
    { "id": "te-08", "competency": "STEM_BIO11/12-IIa-j-10", "text": "When O₂ accepts electrons in the ETC, it forms:", "options": [{"key":"a","label":"CO₂","correct":false},{"key":"b","label":"H₂O","correct":true},{"key":"c","label":"Glucose","correct":false},{"key":"d","label":"ATP","correct":false}] },
    { "id": "te-09", "competency": "STEM_BIO11/12-IIa-j-10", "text": "Without oxygen, the ETC:", "options": [{"key":"a","label":"Continues normally","correct":false},{"key":"b","label":"Halts; NADH accumulates","correct":true},{"key":"c","label":"Produces more ATP","correct":false},{"key":"d","label":"Runs backward","correct":false}] },
    { "id": "te-10", "competency": "STEM_BIO11/12-IIa-j-10", "text": "Fermentation's main purpose is to:", "options": [{"key":"a","label":"Produce 36 ATP","correct":false},{"key":"b","label":"Regenerate NAD⁺","correct":true},{"key":"c","label":"Fix CO₂","correct":false},{"key":"d","label":"Produce O₂","correct":false}] },
    { "id": "te-11", "competency": "STEM_BIO11/12-IIa-j-10", "text": "Which pathway occurs in muscle cells during intense exercise?", "options": [{"key":"a","label":"Alcoholic fermentation","correct":false},{"key":"b","label":"Lactic acid fermentation","correct":true},{"key":"c","label":"Photosynthesis","correct":false},{"key":"d","label":"Krebs cycle only","correct":false}] },
    { "id": "te-12", "competency": "STEM_BIO11/12-IIa-j-10", "text": "The product of lactic acid fermentation is:", "options": [{"key":"a","label":"Ethanol","correct":false},{"key":"b","label":"CO₂","correct":false},{"key":"c","label":"Lactate","correct":true},{"key":"d","label":"Glucose","correct":false}] },
    { "id": "te-13", "competency": "STEM_BIO11/12-IIa-j-11", "text": "If 4 glucose are fully oxidized aerobically, how many ATP (approx) are produced?", "options": [{"key":"a","label":"32","correct":false},{"key":"b","label":"64","correct":false},{"key":"c","label":"128","correct":true},{"key":"d","label":"200","correct":false}] },
    { "id": "te-14", "competency": "STEM_BIO11/12-IIa-j-11", "text": "If 8 NADH pass through the ETC, ATP produced (approx)?", "options": [{"key":"a","label":"8","correct":false},{"key":"b","label":"16","correct":false},{"key":"c","label":"20","correct":true},{"key":"d","label":"24","correct":false}] },
    { "id": "te-15", "competency": "STEM_BIO11/12-IIa-j-11", "text": "How many ATP are needed to fix 10 CO₂ in the Calvin cycle?", "options": [{"key":"a","label":"20","correct":false},{"key":"b","label":"30","correct":true},{"key":"c","label":"40","correct":false},{"key":"d","label":"60","correct":false}] },
    { "id": "te-16", "competency": "STEM_BIO11/12-IIa-j-11", "text": "Which produces more ATP per glucose?", "options": [{"key":"a","label":"Fermentation","correct":false},{"key":"b","label":"Aerobic respiration","correct":true},{"key":"c","label":"Both equal","correct":false},{"key":"d","label":"Neither","correct":false}] },
    { "id": "te-17", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which is an advantage of fermentation?", "options": [{"key":"a","label":"High ATP yield","correct":false},{"key":"b","label":"Works without oxygen","correct":true},{"key":"c","label":"Uses mitochondria","correct":false},{"key":"d","label":"Long-term sustainability","correct":false}] },
    { "id": "te-18", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which is a disadvantage of aerobic respiration?", "options": [{"key":"a","label":"Requires oxygen","correct":true},{"key":"b","label":"Low ATP yield","correct":false},{"key":"c","label":"Very fast","correct":false},{"key":"d","label":"Produces O₂","correct":false}] },
    { "id": "te-19", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which process is used in bread-making?", "options": [{"key":"a","label":"Lactic acid fermentation","correct":false},{"key":"b","label":"Alcoholic fermentation","correct":true},{"key":"c","label":"Aerobic respiration","correct":false},{"key":"d","label":"Photosynthesis","correct":false}] },
    { "id": "te-20", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which food product uses lactic acid fermentation?", "options": [{"key":"a","label":"Bread","correct":false},{"key":"b","label":"Beer","correct":false},{"key":"c","label":"Yogurt","correct":true},{"key":"d","label":"Wine","correct":false}] },
    { "id": "te-21", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which process produces CO₂ as a waste product?", "options": [{"key":"a","label":"Lactic acid fermentation","correct":false},{"key":"b","label":"Alcoholic fermentation","correct":true},{"key":"c","label":"Photosynthesis","correct":false},{"key":"d","label":"Photophosphorylation","correct":false}] },
    { "id": "te-22", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Fermentation produces how many net ATP per glucose?", "options": [{"key":"a","label":"0","correct":false},{"key":"b","label":"2","correct":true},{"key":"c","label":"18","correct":false},{"key":"d","label":"32","correct":false}] },
    { "id": "te-23", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Glycolysis occurs in which location?", "options": [{"key":"a","label":"Cytoplasm","correct":true},{"key":"b","label":"Mitochondrial matrix","correct":false},{"key":"c","label":"Inner mitochondrial membrane","correct":false},{"key":"d","label":"Nucleus","correct":false}] },
    { "id": "te-24", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Krebs cycle occurs in which location?", "options": [{"key":"a","label":"Cytoplasm","correct":false},{"key":"b","label":"Mitochondrial matrix","correct":true},{"key":"c","label":"Inner membrane","correct":false},{"key":"d","label":"Nucleus","correct":false}] },
    { "id": "te-25", "competency": "STEM_BIO11/12-IIa-j-12", "text": "ETC occurs in which location?", "options": [{"key":"a","label":"Cytoplasm","correct":false},{"key":"b","label":"Mitochondrial matrix","correct":false},{"key":"c","label":"Inner mitochondrial membrane","correct":true},{"key":"d","label":"Nucleus","correct":false}] },
    { "id": "te-26", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Chemiosmosis produces ATP by:", "options": [{"key":"a","label":"Substrate-level phosphorylation","correct":false},{"key":"b","label":"H⁺ gradient through ATP synthase","correct":true},{"key":"c","label":"Light absorption","correct":false},{"key":"d","label":"Direct ATP transfer","correct":false}] },
    { "id": "te-27", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which organism performs alcoholic fermentation?", "options": [{"key":"a","label":"Yeast","correct":true},{"key":"b","label":"Muscle cells","correct":false},{"key":"c","label":"Nerve cells","correct":false},{"key":"d","label":"Red blood cells","correct":false}] },
    { "id": "te-28", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Anaerobic respiration yields how many ATP per glucose?", "options": [{"key":"a","label":"2","correct":true},{"key":"b","label":"18","correct":false},{"key":"c","label":"32","correct":false},{"key":"d","label":"36","correct":false}] },
    { "id": "te-29", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which process would occur in a cell with no mitochondria?", "options": [{"key":"a","label":"Krebs cycle","correct":false},{"key":"b","label":"ETC","correct":false},{"key":"c","label":"Glycolysis + fermentation","correct":true},{"key":"d","label":"Photosynthesis","correct":false}] },
    { "id": "te-30", "competency": "STEM_BIO11/12-IIa-j-12", "text": "In which scenario is aerobic respiration most important?", "options": [{"key":"a","label":"100m sprint","correct":false},{"key":"b","label":"Marathon running","correct":true},{"key":"c","label":"Yeast in bread","correct":false},{"key":"d","label":"Bacteria in yogurt","correct":false}] }
    { "id": "te-31", "competency": "STEM_BIO11/12-IIa-j-9", "text": "Which molecule is the universal energy currency of cells?", "options": [{"key":"a","label":"ATP","correct":true},{"key":"b","label":"NADH","correct":false},{"key":"c","label":"FADH₂","correct":false},{"key":"d","label":"Glucose","correct":false}] },
    { "id": "te-32", "competency": "STEM_BIO11/12-IIa-j-9", "text": "ATP hydrolysis releases approximately how much energy?", "options": [{"key":"a","label":"7.3 kcal/mol","correct":true},{"key":"b","label":"1 kcal/mol","correct":false},{"key":"c","label":"30 kcal/mol","correct":false},{"key":"d","label":"100 kcal/mol","correct":false}] },
    { "id": "te-33", "competency": "STEM_BIO11/12-IIa-j-9", "text": "Which is NOT a product of glycolysis?", "options": [{"key":"a","label":"Pyruvate","correct":false},{"key":"b","label":"ATP","correct":false},{"key":"c","label":"NADH","correct":false},{"key":"d","label":"CO₂","correct":true}] },
    { "id": "te-34", "competency": "STEM_BIO11/12-IIa-j-9", "text": "In the ETC, how many ATP molecules are produced from 10 NADH?", "options": [{"key":"a","label":"10","correct":false},{"key":"b","label":"25","correct":true},{"key":"c","label":"30","correct":false},{"key":"d","label":"40","correct":false}] },
    { "id": "te-35", "competency": "STEM_BIO11/12-IIa-j-9", "text": "The ATP-ADP cycle is important because:", "options": [{"key":"a","label":"ATP is stored long-term","correct":false},{"key":"b","label":"ATP is regenerated on demand","correct":true},{"key":"c","label":"ATP is broken down permanently","correct":false},{"key":"d","label":"ATP is only made in plants","correct":false}] },
    { "id": "te-36", "competency": "STEM_BIO11/12-IIa-j-10", "text": "Without oxygen, which process allows glycolysis to continue?", "options": [{"key":"a","label":"Krebs cycle","correct":false},{"key":"b","label":"Fermentation","correct":true},{"key":"c","label":"ETC","correct":false},{"key":"d","label":"Photosynthesis","correct":false}] },
    { "id": "te-37", "competency": "STEM_BIO11/12-IIa-j-10", "text": "Which enzyme regenerates NAD⁺ during fermentation?", "options": [{"key":"a","label":"ATP synthase","correct":false},{"key":"b","label":"Lactate dehydrogenase or alcohol dehydrogenase","correct":true},{"key":"c","label":"RuBisCO","correct":false},{"key":"d","label":"DNA polymerase","correct":false}] },
    { "id": "te-38", "competency": "STEM_BIO11/12-IIa-j-10", "text": "What happens to pyruvate in the absence of oxygen?", "options": [{"key":"a","label":"It enters the Krebs cycle","correct":false},{"key":"b","label":"It is converted to lactate or ethanol","correct":true},{"key":"c","label":"It is converted to glucose","correct":false},{"key":"d","label":"It is stored as glycogen","correct":false}] },
    { "id": "te-39", "competency": "STEM_BIO11/12-IIa-j-10", "text": "The role of oxygen in respiration is to:", "options": [{"key":"a","label":"Accept electrons at the end of the ETC","correct":true},{"key":"b","label":"Produce glucose","correct":false},{"key":"c","label":"Fix carbon","correct":false},{"key":"d","label":"Generate heat only","correct":false}] },
    { "id": "te-40", "competency": "STEM_BIO11/12-IIa-j-10", "text": "Which of the following does NOT require oxygen?", "options": [{"key":"a","label":"Krebs cycle","correct":false},{"key":"b","label":"ETC","correct":false},{"key":"c","label":"Glycolysis","correct":true},{"key":"d","label":"Oxidative phosphorylation","correct":false}] },
    { "id": "te-41", "competency": "STEM_BIO11/12-IIa-j-11", "text": "If 6 FADH₂ pass through the ETC, how many ATP are produced?", "options": [{"key":"a","label":"6","correct":false},{"key":"b","label":"9","correct":true},{"key":"c","label":"15","correct":false},{"key":"d","label":"18","correct":false}] },
    { "id": "te-42", "competency": "STEM_BIO11/12-IIa-j-11", "text": "How many ATP are needed to fix 6 CO₂ in the Calvin cycle?", "options": [{"key":"a","label":"6","correct":false},{"key":"b","label":"12","correct":false},{"key":"c","label":"18","correct":true},{"key":"d","label":"24","correct":false}] },
    { "id": "te-43", "competency": "STEM_BIO11/12-IIa-j-11", "text": "Total ATP produced from 3 glucose in aerobic respiration (modern estimate)?", "options": [{"key":"a","label":"30","correct":false},{"key":"b","label":"64","correct":false},{"key":"c","label":"96","correct":true},{"key":"d","label":"120","correct":false}] },
    { "id": "te-44", "competency": "STEM_BIO11/12-IIa-j-11", "text": "If 20 NADH are produced, how many ATP will the ETC generate?", "options": [{"key":"a","label":"20","correct":false},{"key":"b","label":"40","correct":false},{"key":"c","label":"50","correct":true},{"key":"d","label":"60","correct":false}] },
    { "id": "te-45", "competency": "STEM_BIO11/12-IIa-j-11", "text": "Which stage produces the least ATP directly?", "options": [{"key":"a","label":"Glycolysis","correct":false},{"key":"b","label":"Krebs cycle","correct":true},{"key":"c","label":"ETC","correct":false},{"key":"d","label":"All equal","correct":false}] },
    { "id": "te-46", "competency": "STEM_BIO11/12-IIa-j-11", "text": "The theoretical maximum ATP yield per glucose is:", "options": [{"key":"a","label":"2","correct":false},{"key":"b","label":"18","correct":false},{"key":"c","label":"32 (modern estimate)","correct":true},{"key":"d","label":"100","correct":false}] },
    { "id": "te-47", "competency": "STEM_BIO11/12-IIa-j-11", "text": "Approximately what % of glucose's energy is captured as ATP in respiration?", "options": [{"key":"a","label":"1%","correct":false},{"key":"b","label":"10%","correct":false},{"key":"c","label":"34%","correct":true},{"key":"d","label":"90%","correct":false}] },
    { "id": "te-48", "competency": "STEM_BIO11/12-IIa-j-11", "text": "Which yields more ATP: 1 glucose aerobic OR 1 glucose fermentation?", "options": [{"key":"a","label":"Fermentation","correct":false},{"key":"b","label":"Aerobic","correct":true},{"key":"c","label":"Equal","correct":false},{"key":"d","label":"Neither produces ATP","correct":false}] },
    { "id": "te-49", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which condition allows rapid ATP production but with low yield?", "options": [{"key":"a","label":"Aerobic respiration","correct":false},{"key":"b","label":"Fermentation","correct":true},{"key":"c","label":"Photosynthesis","correct":false},{"key":"d","label":"Krebs cycle only","correct":false}] },
    { "id": "te-50", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which process is used in the industrial production of ethanol?", "options": [{"key":"a","label":"Aerobic respiration","correct":false},{"key":"b","label":"Alcoholic fermentation","correct":true},{"key":"c","label":"Photosynthesis","correct":false},{"key":"d","label":"Krebs cycle","correct":false}] },
    { "id": "te-51", "competency": "STEM_BIO11/12-IIa-j-12", "text": "A cell can switch between aerobic and anaerobic pathways based on:", "options": [{"key":"a","label":"Oxygen availability","correct":true},{"key":"b","label":"Cell color","correct":false},{"key":"c","label":"Cell size","correct":false},{"key":"d","label":"Number of chromosomes","correct":false}] },
    { "id": "te-52", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Lactic acid buildup in muscles causes:", "options": [{"key":"a","label":"Muscle fatigue and soreness","correct":true},{"key":"b","label":"Faster ATP production permanently","correct":false},{"key":"c","label":"Muscle growth","correct":false},{"key":"d","label":"Improved oxygen transport","correct":false}] },
    { "id": "te-53", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which of the following is a commercial use of fermentation?", "options": [{"key":"a","label":"Biofuel production","correct":true},{"key":"b","label":"Solar panels","correct":false},{"key":"c","label":"Wind turbines","correct":false},{"key":"d","label":"Nuclear energy","correct":false}] },
    { "id": "te-54", "competency": "STEM_BIO11/12-IIa-j-12", "text": "In which scenario would a cell prefer aerobic respiration?", "options": [{"key":"a","label":"When O₂ is abundant","correct":true},{"key":"b","label":"When O₂ is absent","correct":false},{"key":"c","label":"In the cytoplasm only","correct":false},{"key":"d","label":"When glucose is absent","correct":false}] },
    { "id": "te-55", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Fermentation regenerates which molecule needed for glycolysis?", "options": [{"key":"a","label":"ATP","correct":false},{"key":"b","label":"NAD⁺","correct":true},{"key":"c","label":"FAD","correct":false},{"key":"d","label":"Glucose","correct":false}] },
    { "id": "te-56", "competency": "STEM_BIO11/12-IIa-j-12", "text": "What happens to yeast in an airtight container with sugar?", "choices": [], "options": [{"key":"a","label":"Alcoholic fermentation produces ethanol + CO₂","correct":true},{"key":"b","label":"Aerobic respiration produces H₂O","correct":false},{"key":"c","label":"Photosynthesis produces O₂","correct":false},{"key":"d","label":"Nothing happens","correct":false}] },
    { "id": "te-57", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which of the following is a disadvantage of lactic acid fermentation?", "options": [{"key":"a","label":"Produces only 2 ATP per glucose","correct":true},{"key":"b","label":"Requires oxygen","correct":false},{"key":"c","label":"Produces too much ATP","correct":false},{"key":"d","label":"Requires mitochondria","correct":false}] },
    { "id": "te-58", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which process would you expect in a marathon runner's muscle cells at mile 20?", "options": [{"key":"a","label":"Aerobic respiration","correct":true},{"key":"b","label":"Lactic acid fermentation","correct":false},{"key":"c","label":"Alcoholic fermentation","correct":false},{"key":"d","label":"Photosynthesis","correct":false}] },
    { "id": "te-59", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which process would you expect during a 100m sprint?", "options": [{"key":"a","label":"Aerobic respiration","correct":false},{"key":"b","label":"Lactic acid fermentation","correct":true},{"key":"c","label":"Alcoholic fermentation","correct":false},{"key":"d","label":"Photosynthesis","correct":false}] },
    { "id": "te-60", "competency": "STEM_BIO11/12-IIa-j-12", "text": "Which best summarizes the relationship between photosynthesis and respiration?", "options": [{"key":"a","label":"They are independent processes","correct":false},{"key":"b","label":"Products of one are reactants of the other — life's energy cycle","correct":true},{"key":"c","label":"They occur only in plants","correct":false},{"key":"d","label":"They both produce oxygen","correct":false}] }
