    {
      "n": 1,
      "title": "Incomplete Dominance & Codominance",
      "competency": "STEM_BIO11/12-IIIa-b-3",
      "content": "<h3>🎯 Learning Objectives</h3><ul><li>Define incomplete dominance.</li><li>Define codominance.</li><li>Differentiate these from complete dominance.</li><li>Predict offspring ratios.</li></ul><h3>🔑 Key Concepts</h3><ul><li><strong>Incomplete dominance</strong> — heterozygote shows an intermediate phenotype.</li><li><strong>Codominance</strong> — both alleles expressed distinctly.</li><li><strong>Complete dominance</strong> — one allele masks the other.</li></ul><h3>📚 Lesson Content</h3><h4>A. Incomplete Dominance</h4><p>Red flower (RR) × White flower (WW) → All Pink (RW). The heterozygote shows a blend.</p><h4>B. Codominance</h4><p>Red flower (RR) × White flower (WW) → Red AND White patches (RW). Both alleles expressed.</p><h4>C. Human Example</h4><ul><li><strong>AB blood type</strong> — codominance (A and B both expressed)</li><li><strong>Sickle-cell trait</strong> — codominance at the molecular level</li></ul><h4>D. Comparison</h4><table><thead><tr><th>Pattern</th><th>Heterozygote Phenotype</th></tr></thead><tbody><tr><td>Complete dominance</td><td>Dominant trait only</td></tr><tr><td>Incomplete dominance</td><td>Intermediate (blended)</td></tr><tr><td>Codominance</td><td>Both traits expressed</td></tr></tbody></table>",
      "activity1": {
        "timeLimit": 90,
        "badgeId": "dominance-master",
        "badgeName": "Dominance Master",
        "badgeIcon": "🌸",
        "pairs": [
          { "key": "comp", "left": "Complete dominance", "right": "One allele masks the other" },
          { "key": "incomp", "left": "Incomplete dominance", "right": "Intermediate phenotype" },
          { "key": "codom", "left": "Codominance", "right": "Both alleles expressed" },
          { "key": "pink", "left": "RR × WW → RW", "right": "Pink in incomplete dominance" },
          { "key": "patch", "left": "RR × WW → patches", "right": "Codominance" },
          { "key": "ab", "left": "AB blood type", "right": "Codominance example" }
        ]
      },
      "activity2": {
        "timePerCard": 12,
        "badgeId": "dominance-detective",
        "badgeName": "Dominance Detective",
        "badgeIcon": "🕵️",
        "scenarios": [
          { "text": "Red × White → All Pink flowers.", "choices": [{ "label": "Incomplete dominance ✓", "correct": true }, { "label": "Codominance", "correct": false }, { "label": "Complete dominance", "correct": false }] },
          { "text": "Red × White → Red AND White patches.", "choices": [{ "label": "Incomplete dominance", "correct": false }, { "label": "Codominance ✓", "correct": true }, { "label": "Complete dominance", "correct": false }] },
          { "text": "AB blood type shows both A and B.", "choices": [{ "label": "Codominance ✓", "correct": true }, { "label": "Incomplete dominance", "correct": false }] },
          { "text": "Heterozygote shows a blend of parental traits.", "choices": [{ "label": "Incomplete dominance ✓", "correct": true }, { "label": "Codominance", "correct": false }] },
          { "text": "Sickle-cell trait shows both normal and sickled cells.", "choices": [{ "label": "Codominance ✓", "correct": true }, { "label": "Incomplete dominance", "correct": false }] },
          { "text": "RW × RW → what ratio?", "choices": [{ "label": "1 RR : 2 RW : 1 WW ✓", "correct": true }, { "label": "3:1", "correct": false }] }
        ]
      },
      "formative": {
        "badgeId": "dominance-escape",
        "badgeName": "Dominance Escapee",
        "badgeIcon": "🔐",
        "lives": 3,
        "questions": [
          { "text": "In incomplete dominance, the heterozygote shows:", "choices": [{ "label": "Dominant trait", "correct": false }, { "label": "Intermediate phenotype", "correct": true }, { "label": "Recessive trait", "correct": false }, { "label": "Neither trait", "correct": false }] },
          { "text": "AB blood type is an example of:", "choices": [{ "label": "Complete dominance", "correct": false }, { "label": "Incomplete dominance", "correct": false }, { "label": "Codominance", "correct": true }, { "label": "Sex linkage", "correct": false }] },
          { "text": "Which pattern shows BOTH alleles expressed distinctly?", "choices": [{ "label": "Complete dominance", "correct": false }, { "label": "Incomplete dominance", "correct": false }, { "label": "Codominance", "correct": true }, { "label": "Epistasis", "correct": false }] }
        ]
      },
      "takeaways": [
        "Incomplete dominance = intermediate phenotype.",
        "Codominance = both alleles expressed.",
        "Complete dominance = one allele masks the other.",
        "AB blood type is an example of codominance."
      ]
    },
