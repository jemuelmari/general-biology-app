      "n": 2,
      "title": "Natural Selection",
      "competency": "STEM_BIO11/12-IIIC-g-9",
      "content": "<h3>🎯 Learning Objectives</h3><ul><li>Define natural selection.</li><li>Explain the conditions for natural selection.</li><li>Describe types of selection.</li><li>Give real-world examples.</li></ul><h3>🔑 Key Concepts</h3><ul><li><strong>Natural selection</strong> — differential survival and reproduction based on heritable traits.</li><li><strong>Fitness</strong> — reproductive success.</li><li><strong>Adaptation</strong> — a trait that increases fitness.</li><li><strong>Directional, stabilizing, disruptive selection</strong> — three patterns.</li></ul><h3>📚 Lesson Content</h3><h4>A. Conditions for Natural Selection</h4><ul><li>Variation exists in the population</li><li>Variation is heritable</li><li>More offspring are produced than can survive</li><li>Some variants have higher fitness</li></ul><h4>B. Types of Selection</h4><table><thead><tr><th>Type</th><th>Effect</th></tr></thead><tbody><tr><td>Directional</td><td>Favors one extreme</td></tr><tr><td>Stabilizing</td><td>Favors the average</td></tr><tr><td>Disruptive</td><td>Favors both extremes</td></tr></tbody></table><h4>C. Example</h4><p>Peppered moths in industrial England: dark moths were favored on soot-covered trees.</p>",
      "activity1": {
        "timeLimit": 90,
        "badgeId": "natural-sel-master",
        "badgeName": "Natural Selection Master",
        "badgeIcon": "🦋",
        "pairs": [
          { "key": "ns", "left": "Natural selection", "right": "Differential survival & reproduction" },
          { "key": "fit", "left": "Fitness", "right": "Reproductive success" },
          { "key": "adapt", "left": "Adaptation", "right": "Trait that increases fitness" },
          { "key": "dir", "left": "Directional selection", "right": "Favors one extreme" },
          { "key": "stab", "left": "Stabilizing selection", "right": "Favors the average" },
          { "key": "dis", "left": "Disruptive selection", "right": "Favors both extremes" }
        ]
      },
