          { "key": "var", "left": "Variation", "right": "Raw material for evolution" },
          { "key": "rand", "left": "Mutation is", "right": "Random with respect to fitness" },
          { "key": "cross", "left": "Crossing over", "right": "Prophase I of meiosis" }
