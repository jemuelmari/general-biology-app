          { "key": "founder", "left": "Founder effect", "right": "Small group colonizes" },
          { "key": "flow", "left": "Gene flow", "right": "Movement of alleles" },
          { "key": "small", "left": "Small populations", "right": "Drift is stronger" },
          { "key": "reduce", "left": "Gene flow reduces", "right": "Differences between populations" }
