          { "text": "Net ATP from glycolysis:", "choices": [{ "label": "2 ✓", "correct": true }, { "label": "4", "correct": false }, { "label": "36", "correct": false }] },
          { "text": "NADH is produced.", "choices": [{ "label": "Glycolysis ✓", "correct": true }, { "label": "Fermentation", "correct": false }] }
        ]
      },
