{
  "week": 5,
  "title": "Biological Molecules",
  "days": [
    {
      "n": 1,
      "title": "Carbohydrates",
      "competency": "STEM_BIO11/12-II-i-j-15",
      "content": "<h3>🎯 Learning Objectives</h3><ul><li>Describe the structure of carbohydrates.</li><li>Differentiate monosaccharides, disaccharides, and polysaccharides.</li><li>Explain the functions of carbohydrates.</li><li>Identify food sources.</li></ul><h3>🔑 Key Concepts</h3><ul><li><strong>Monosaccharide</strong> — single sugar unit (glucose, fructose).</li><li><strong>Disaccharide</strong> — two sugar units (sucrose, lactose).</li><li><strong>Polysaccharide</strong> — many sugar units (starch, glycogen, cellulose).</li><li><strong>Glycosidic bond</strong> — bond between sugar units.</li></ul><h3>📚 Lesson Content</h3><h4>A. Structure</h4><p>Carbohydrates contain C, H, O in a 1:2:1 ratio (CH₂O)ₙ. They are the body's primary quick-energy source.</p><h4>B. Types</h4><table><thead><tr><th>Type</th><th>Example</th><th>Function</th></tr></thead><tbody><tr><td>Monosaccharide</td><td>Glucose, fructose</td><td>Immediate energy</td></tr><tr><td>Disaccharide</td><td>Sucrose, lactose</td><td>Transport sugar</td></tr><tr><td>Polysaccharide</td><td>Starch (plants), glycogen (animals), cellulose (cell walls)</td><td>Storage & structure</td></tr></tbody></table><h4>C. Functions in Metabolism</h4><ul><li>Primary source of ATP via cellular respiration</li><li>Structural component (cellulose in plant cell walls)</li><li>Energy storage (glycogen in liver and muscle)</li></ul>",
      "activity1": {
        "timeLimit": 90,
        "badgeId": "carbs-master",
        "badgeName": "Carb Master",
        "badgeIcon": "🍞",
        "pairs": [
          { "key": "mono", "left": "Monosaccharide", "right": "Single sugar (glucose)" },
          { "key": "di", "left": "Disaccharide", "right": "Two sugars (sucrose)" },
          { "key": "poly", "left": "Polysaccharide", "right": "Many sugars (starch)" },
          { "key": "glyco", "left": "Glycogen", "right": "Animal energy storage" },
          { "key": "cell", "left": "Cellulose", "right": "Plant cell wall" },
          { "key": "starch", "left": "Starch", "right": "Plant energy storage" }
        ]
      },
      "activity2": {
        "timePerCard": 12,
        "badgeId": "carb-detective",
        "badgeName": "Carb Detective",
        "badgeIcon": "🕵️",
        "scenarios": [
          { "text": "Glucose is an example of:", "choices": [{ "label": "Monosaccharide ✓", "correct": true }, { "label": "Disaccharide", "correct": false }, { "label": "Polysaccharide", "correct": false }] },
          { "text": "Sucrose (table sugar) is a:", "choices": [{ "label": "Monosaccharide", "correct": false }, { "label": "Disaccharide ✓", "correct": true }, { "label": "Polysaccharide", "correct": false }] },
          { "text": "Starch is a:", "choices": [{ "label": "Monosaccharide", "correct": false }, { "label": "Disaccharide", "correct": false }, { "label": "Polysaccharide ✓", "correct": true }] },
          { "text": "Which is found in plant cell walls?", "choices": [{ "label": "Glycogen", "correct": false }, { "label": "Cellulose ✓", "correct": true }, { "label": "Glucose", "correct": false }] },
          { "text": "Which is the body's stored form of glucose in animals?", "choices": [{ "label": "Glycogen ✓", "correct": true }, { "label": "Cellulose", "correct": false }, { "label": "Sucrose", "correct": false }] },
          { "text": "Primary function of carbohydrates in metabolism:", "choices": [{ "label": "Genetic information", "correct": false }, { "label": "Quick energy", "correct": true }, { "label": "Long-term insulation", "correct": false }] }
        ]
      },
      "formative": {
        "badgeId": "carb-escape",
        "badgeName": "Carb Escapee",
        "badgeIcon": "🔐",
        "lives": 3,
        "questions": [
          { "text": "What is the chemical ratio of C:H:O in carbohydrates?", "choices": [{ "label": "1:2:1", "correct": true }, { "label": "2:1:1", "correct": false }, { "label": "1:1:1", "correct": false }, { "label": "1:1:2", "correct": false }] },
          { "text": "Which polysaccharide is found in plant cell walls?", "choices": [{ "label": "Starch", "correct": false }, { "label": "Glycogen", "correct": false }, { "label": "Cellulose", "correct": true }, { "label": "Sucrose", "correct": false }] },
          { "text": "Which carbohydrate is the primary energy currency in cells?", "choices": [{ "label": "Cellulose", "correct": false }, { "label": "Glucose", "correct": true }, { "label": "Starch", "correct": false }, { "label": "Lactose", "correct": false }] }
        ]
      },
      "takeaways": [
        "Carbohydrates contain C, H, O in a 1:2:1 ratio.",
        "Three types: monosaccharides, disaccharides, polysaccharides.",
        "Primary function is quick energy; also structural (cellulose) and storage (glycogen).",
        "Glucose is the key energy molecule in cells."
      ]
