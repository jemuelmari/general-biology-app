          { "text": "Which lipid type is a component of cell membranes?", "choices": [{ "label": "Triglyceride", "correct": false }, { "label": "Phospholipid", "correct": true }, { "label": "Wax", "correct": false }, { "label": "Cholesterol ester", "correct": false }] },
