          { "text": "Which lipid forms cell membranes?", "choices": [{ "label": "Triglyceride", "correct": false }, { "label": "Phospholipid ✓", "correct": true }, { "label": "Steroid", "correct": false }] },
          { "text": "Cholesterol is a:", "choices": [{ "label": "Triglyceride", "correct": false }, { "label": "Phospholipid", "correct": false }, { "label": "Steroid ✓", "correct": true }] },
          { "text": "Butter is an example of:", "choices": [{ "label": "Saturated fat ✓", "correct": true }, { "label": "Unsaturated fat", "correct": false }, { "label": "Phospholipid", "correct": false }] },
