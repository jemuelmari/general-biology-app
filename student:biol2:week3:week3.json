          { "text": "The Law of Segregation states that:", "choices": [{ "label": "Alleles separate during gamete formation", "correct": true }, { "label": "All alleles are dominant", "correct": false }, { "label": "Genes don't sort", "correct": false }, { "label": "Alleles fuse", "correct": false }] },
          { "text": "An organism with Tt is:", "choices": [{ "label": "Homozygous dominant", "correct": false }, { "label": "Heterozygous", "correct": true }, { "label": "Homozygous recessive", "correct": false }, { "label": "Pure-breeding", "correct": false }] }
