          { "key": "comp", "left": "Competitive inhibitor", "right": "Binds the active site" },
          { "key": "non", "left": "Non-competitive inhibitor", "right": "Binds elsewhere, changes shape" },
          { "key": "sat", "left": "Saturation", "right": "All active sites occupied" }
        ]
