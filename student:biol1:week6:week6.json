          { "key": "cof", "left": "Cofactor", "right": "Non-protein helper (metal ion)" },
          { "key": "coe", "left": "Coenzyme", "right": "Organic helper (NAD⁺)" },
          { "key": "holo", "left": "Holoenzyme", "right": "Complete active enzyme" }
        ]
      },
