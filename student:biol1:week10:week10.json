      "n": 1,
      "title": "ATP Computation Practice",
      "competency": "STEM_BIO11/12-IIa-j-11",
      "content": "<h3>🎯 Learning Objectives</h3><ul><li>Compute ATP yields for respiration stages.</li><li>Compute ATP needs for photosynthesis.</li><li>Interpret ATP yield problems.</li><li>Compare photosynthesis and respiration energetics.</li></ul><h3>🔑 Key Concepts</h3><ul><li><strong>ATP yield</strong> — total ATP produced.</li><li><strong>ATP need</strong> — total ATP consumed.</li><li><strong>Efficiency</strong> — energy captured vs. total energy.</li></ul><h3>📚 Lesson Content</h3><h4>A. Respiration ATP Yield</h4><ul><li>Glycolysis: 2 ATP + 2 NADH</li><li>Pyruvate oxidation: 2 NADH</li><li>Krebs: 2 ATP + 6 NADH + 2 FADH₂</li><li>ETC: 10 NADH × 2.5 + 2 FADH₂ × 1.5 = 25 + 3 = 28 ATP</li><li><strong>Total: ~32 ATP</strong></li></ul><h4>B. Photosynthesis ATP Need</h4><ul><li>Per CO₂: 3 ATP + 2 NADPH</li><li>Per glucose (6 CO₂): 18 ATP + 12 NADPH</li></ul><h4>C. Efficiency Comparison</h4><ul><li>Respiration captures ~34% of glucose energy as ATP.</li><li>Photosynthesis captures ~1% of solar energy.</li></ul>",
      "activity1": {
        "timeLimit": 90,
        "badgeId": "atp-compute-master",
        "badgeName": "ATP Compute Master",
        "badgeIcon": "🧮",
        "pairs": [
          { "key": "gly", "left": "Glycolysis ATP", "right": "2" },
          { "key": "krebs", "left": "Krebs ATP", "right": "2" },
          { "key": "etc", "left": "ETC ATP", "right": "~28" },
          { "key": "total", "left": "Total ATP", "right": "~32" },
          { "key": "photo", "left": "Photosynthesis ATP used", "right": "18 per glucose" },
          { "key": "naph", "left": "NADPH used", "right": "12 per glucose" }
        ]
